	<queryString language="SQL">
		<![CDATA[SELECT 
    a.employee_name,
    c.depertment_name,
    d.designation_name,
    date_format(e.joining_date, "%e %b, %y") as joining_date,
    b.basic_salary
FROM
    hrm_employee AS a
        JOIN
    hrm_employee_job_info AS b ON a.id = b.hrm_employee_id
        LEFT JOIN
    hrm_depertment AS c ON c.id = b.hrm_depertment_id
        LEFT JOIN
    hrm_designation AS d ON d.id = b.hrm_designation_id
        JOIN
    hrm_employee_joining AS e ON e.hrm_employee_id = b.hrm_employee_id]]>
	</queryString>
