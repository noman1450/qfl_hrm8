	<parameter name="condition_parameter" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT aa.depertment_name,Sum(Total_Employee) As total_employee,Sum(Present) As Present,
Sum(Absent) As Absent,Sum(Leave_s) As Leave_s,SUM(Holiday) as Holiday
FROM
(SELECT
    c.depertment_name,
    COUNT(a.hrm_employee_id) AS Total_Employee,
    0 AS Present,
    0 As Absent,
    0 As Leave_s,
    0 As Holiday

FROM
    hrm_attendance a
        JOIN
    hrm_employee_job_info b ON a.hrm_employee_id = b.hrm_employee_id
        JOIN
    hrm_depertment c ON b.hrm_depertment_id = c.id
        JOIN
    hrm_designation d ON b.hrm_designation_id = d.id
    
    $P!{condition_parameter}
GROUP BY c.id
UNION
SELECT
    c.depertment_name,
    0 AS Total_Employee,
    COUNT(a.hrm_employee_id) AS Present,
    0 As Absent,
    0 As Leave_s,
    0 As Holiday
FROM
    hrm_attendance a
        JOIN
    hrm_employee_job_info b ON a.hrm_employee_id = b.hrm_employee_id
        AND a.attendance_status IN (2 , 5, 6)
        JOIN
    hrm_depertment c ON b.hrm_depertment_id = c.id
        JOIN
    hrm_designation d ON b.hrm_designation_id = d.id
    
    $P!{condition_parameter}
GROUP BY c.id
UNION
SELECT
    c.depertment_name,
    0 AS Total_Employee,
    0 As Present,
    COUNT(a.hrm_employee_id) AS Absent,
    0 As Leave_s,
    0 As Holiday    
FROM
    hrm_attendance a
        JOIN
    hrm_employee_job_info b ON a.hrm_employee_id = b.hrm_employee_id
        AND a.attendance_status IN (1)
        JOIN
    hrm_depertment c ON b.hrm_depertment_id = c.id
        JOIN
    hrm_designation d ON b.hrm_designation_id = d.id
    
    $P!{condition_parameter}
GROUP BY c.id
UNION
SELECT
    c.depertment_name,
    0 AS Total_Employee,
    0 As Present,
    0 As Absent,
    COUNT(a.hrm_employee_id) AS Leave_s,
    0 As Holiday
FROM
    hrm_attendance a
        JOIN
    hrm_employee_job_info b ON a.hrm_employee_id = b.hrm_employee_id
        AND a.attendance_status IN (3,4,9,10,11,12,13)
        JOIN
    hrm_depertment c ON b.hrm_depertment_id = c.id
        JOIN
    hrm_designation d ON b.hrm_designation_id = d.id
    
    $P!{condition_parameter}
GROUP BY c.id
UNION
SELECT
    c.depertment_name,
    0 AS Total_Employee,
    0 As Present,
    0 As Absent,
    0 Leave_s,
    COUNT(a.hrm_employee_id) AS Holiday
FROM
    hrm_attendance a
        JOIN
    hrm_employee_job_info b ON a.hrm_employee_id = b.hrm_employee_id
        AND a.attendance_status IN (7,8)
        JOIN
    hrm_depertment c ON b.hrm_depertment_id = c.id
        JOIN
    hrm_designation d ON b.hrm_designation_id = d.id
    
    $P!{condition_parameter}
GROUP BY c.id

) aa

GROUP BY aa.depertment_name;]]>
	</queryString>
