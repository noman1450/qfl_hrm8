	<parameter name="bank_id" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT  c.id,
    bb.employee_name,
    c.depertment_name,
    0 as accounts_code,
    e.designation_name,
    e.priority,
    a.account_no,
    concat('X',a.account_no) as  account_no01,
    concat(left(a.account_no,2),'-',SUBSTRING(a.account_no, 3, 8),'-',SUBSTRING(a.account_no, 10, 10)) as account_no02 ,
    left(a.account_no,3) as subacc_1 ,
    SUBSTRING(a.account_no, 4, 3) as subacc_2,
    SUBSTRING(a.account_no, 7) as subacc_3,
    a.bonus_amount AS Net_Pay
FROM
    hrm_employee_bonus_master aa
		JOIN
    hrm_employee_bonus a ON aa.id = a.hrm_employee_bonus_master_id
        AND aa.is_valid = 1
        AND a.is_valid = 1
        JOIN
    hrm_employee_job_info b ON a.hrm_employee_job_info_id = b.id
        AND a.hrm_employee_job_info_id = b.id
        AND a.payment_mode = 2
        AND aa.status <> 0
        JOIN
    hrm_employee bb ON b.hrm_employee_id = bb.id
        JOIN
    hrm_depertment c ON b.hrm_depertment_id = c.id
        JOIN
    hrm_designation e ON b.hrm_designation_id = e.id
 $P!{condition_parameter} 
ORDER BY c.id , e.priority]]>
	</queryString>
