<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="hrm_bonus_sheet" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="9438248a-295f-40af-a669-de9baf60f08d">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="365"/>
	<property name="ireport.y" value="10"/>
	<parameter name="company_name" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="address" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="title" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="condition_parameter" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    a.id,
    c.employee_name,
    c.id AS employee_id,
    d.depertment_name,
    f.designation_name,
    e.location_name,
    '10' as stamp,
    a.bonus_amount,
    (a.bonus_amount-10) as net_bonus,
    IF(h.payment_mode = 1,(a.bonus_amount-10),0) AS cash_amout,
    IF(h.payment_mode = 2,(a.bonus_amount-10),0) AS bank_amout,
    CONCAT(a.amount,
            ' | ',
            IF((a.amount_type = 1), '%', 'Tk.')) AS amount_type,
    a.salary_amount,
    g.joining_date,
    h.account_no,
    h.payment_mode
FROM
    hrm_employee_bonus a
        JOIN
    hrm_employee_job_info b ON a.hrm_employee_job_info_id = b.id
        AND b.employee_activity = 1
        JOIN
    hrm_employee c ON b.hrm_employee_id = c.id
        JOIN
    hrm_depertment d ON b.hrm_depertment_id = d.id
        JOIN
    hrm_location e ON b.hrm_location_id = e.id
        JOIN
    hrm_designation f ON b.hrm_designation_id = f.id
        JOIN
    hrm_employee_joining g ON b.hrm_employee_id = g.hrm_employee_id
        JOIN
    hrm_employee_salary h  ON h.hrm_employee_job_info_id = b.id
   $P!{condition_parameter}
Group by b.hrm_depertment_id,b.hrm_employee_id]]>
	</queryString>
