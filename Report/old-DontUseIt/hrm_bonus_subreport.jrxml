<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="hrm_bonus_subreport" language="groovy" pageWidth="170" pageHeight="842" columnWidth="130" leftMargin="20" rightMargin="20" topMargin="0" bottomMargin="0" uuid="22933b49-9bd5-415b-9ede-e76da4ba5bf1">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="bonus_master_id" class="java.lang.Integer"/>
	<parameter name="hrm_employee_job_info_id" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    SUM(aa.bonus_amount) AS net_total, aa.payment_mode_name
FROM
    (SELECT 
        a.bonus_amount,
            a.hrm_employee_job_info_id,
            IFNULL(c.short_name, 'Cash') AS payment_mode_name
    FROM
        hrm_employee_bonus_master aa
    JOIN hrm_employee_bonus a ON aa.id = a.hrm_employee_bonus_master_id
        AND aa.is_valid = 1
        AND a.is_valid = 1
		AND aa.id =  $P{bonus_master_id} 
    JOIN hrm_employee_job_info b ON a.hrm_employee_job_info_id = b.id
    LEFT JOIN hrm_bank c ON a.hrm_bank_id = c.id) aa
GROUP BY aa.payment_mode_name]]>
	</queryString>
	<field name="net_total" class="java.lang.Double"/>
	<field name="payment_mode_name" class="java.lang.String"/>
	<variable name="net_total_1" class="java.lang.Double" resetType="Column" calculation="Sum">
		<variableExpression><![CDATA[$F{net_total}]]></variableExpression>
	</variable>
	<variable name="net_total_2" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{net_total}]]></variableExpression>
	</variable>
