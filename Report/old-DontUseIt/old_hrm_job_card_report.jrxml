<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="job_card_report" language="groovy" pageWidth="595" pageHeight="842" whenNoDataType="NoPages" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="12525be8-a4c6-45d8-94dd-0b4b2bd74cca">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="111"/>
	<parameter name="title" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="address" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="company_name" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="condition_parameter" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="subquery_parameter" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    a.hrm_employee_id,
     Concat(ifnull(c.employee_name,'') ,'  |  ', ifnull(b.employee_code,'')) as employee_name,
    d.depertment_name,
    e.designation_name,
    f.confirmation_date,
    a.punche_date,
    a.in_time,
    a.out_time,
    a.early_out_time,
    a.late_time,
    a.overtime_time,
    g.attendance_status,
    (SELECT Count(id) FROM hrm_attendance WHERE attendance_status =1 $P!{subquery_parameter}) as absent,
        (SELECT Count(id) FROM hrm_attendance WHERE attendance_status =14 $P!{subquery_parameter}) as EarlyOut,
    (SELECT Count(id) FROM hrm_attendance WHERE attendance_status in(2,5) $P!{subquery_parameter}) as present,
    (SELECT Count(id) FROM hrm_attendance WHERE attendance_status in(3,9,11) $P!{subquery_parameter}) as allLeave,
    (SELECT Count(id) FROM hrm_attendance WHERE attendance_status in(6) $P!{subquery_parameter}) as late,
    (SELECT Count(id) FROM hrm_attendance WHERE attendance_status in(7) $P!{subquery_parameter}) as Friday,
    (SELECT Count(id) FROM hrm_attendance WHERE attendance_status in(8) $P!{subquery_parameter}) as Holiday,
    (SELECT Round((Count(id)/2),0) as HalfDayLeave FROM hrm_attendance WHERE attendance_status in(4,10) $P!{subquery_parameter} ) as HalfDayLeave,
    ((SELECT TIME_FORMAT(SEC_TO_TIME( SUM( TIME_TO_SEC( `overtime_time` ) ) ),'%H:%i') AS latetime FROM hrm_attendance WHERE attendance_status is not null $P!{subquery_parameter})) as totalovertime,
    ((SELECT TIME_FORMAT(SEC_TO_TIME( SUM( TIME_TO_SEC( `late_time` ) ) ),'%H:%i') AS latetime FROM hrm_attendance WHERE attendance_status is not null $P!{subquery_parameter})) as totallatetime


    FROM
    hrm_attendance a
        JOIN
    hrm_employee_job_info b ON a.hrm_employee_id = b.hrm_employee_id
        AND b.employee_activity = 1
        JOIN
    hrm_employee c ON b.hrm_employee_id = c.id
        JOIN
	hrm_depertment d ON b.hrm_depertment_id=d.id
		JOIN
    hrm_designation e ON b.hrm_designation_id=e.id
        JOIN
    hrm_employee_joining f ON b.hrm_employee_id=f.hrm_employee_id
   JOIN
hrm_attendance_status g ON g.id=a.attendance_status
$P!{condition_parameter}
Order By   a.hrm_employee_id,a.punche_date]]>
	</queryString>
