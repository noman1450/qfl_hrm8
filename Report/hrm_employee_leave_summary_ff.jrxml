	<queryString>
		<![CDATA[SELECT
    b.id,
    b.employee_name,
    d.employee_code,
	  g.depertment_name,
	  h.designation_name,
    c.leave_type,
    sum(CASE WHEN a.duration = 1 THEN 0.50 WHEN a.duration = 3 THEN 0.25 ELSE (DATEDIFF(a.date_to, a.date_from) + 1) END)LWP_Days,
    if(a.payment_mode=1,'WP','LWP')payment_mode
FROM
    hrm_leave_application a
        JOIN hrm_employee b ON b.id = a.hrm_employee_id  AND b.active_status = 1 
        right JOIN hrm_employee_leave_type c ON a.hrm_employee_leave_type_id = c.id
        JOIN hrm_employee_job_info d ON a.hrm_employee_id = d.hrm_employee_id
             AND d.id in (SELECT id FROM  hrm_employee_job_info WHERE id in (SELECT max(id) FROM hrm_employee_job_info Group By hrm_employee_id) )
        JOIN hrm_leave_approve f ON f.hrm_leave_application_id = a.id AND f.action_type = 1 AND f.forward = 2
        JOIN hrm_depertment g ON d.hrm_depertment_id = g.id
        JOIN hrm_designation h ON d.hrm_designation_id = h.id
        JOIN hrm_employee_joining i ON i.hrm_employee_id = d.hrm_employee_id
		    JOIN hrm_leave_years j ON a.hrm_leave_years_id=j.id
  where a.valid = 1
  and d.hrm_employee_id in(2028,816)
Group By a.hrm_employee_id, a.hrm_employee_leave_type_id, a.payment_mode
   Order By c.leave_type,a.date_from]]>
	</queryString>
