	<parameter name="condition_parameter_1" class="java.lang.String"/>
	<parameter name="hrm_month_id" class="java.lang.String"/>
	<parameter name="year_id" class="java.lang.String"/>
	<parameter name="bank_id" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT * FROM(SELECT  c.id,
    a.employee_name,
    b.employee_code,
    c.depertment_name,
    aa.accounts_code,
    e.designation_name,
    f.section_name,
    e.priority,
    aa.account_no,
    concat('X',aa.account_no) as  account_no01,
    concat(left(aa.account_no,2),'-',SUBSTRING(aa.account_no, 3, 8),'-',SUBSTRING(aa.account_no, 10, 10)) as account_no02 ,
    	concat(left(aa.account_no,4),'-',SUBSTRING(aa.account_no, 5, 6),'-',SUBSTRING(aa.account_no, 11, 10)) as account_no03 ,
    left(aa.account_no,3) as subacc_1 ,
    SUBSTRING(aa.account_no, 4, 3) as subacc_2,
    SUBSTRING(aa.account_no, 7) as subacc_3,
    SUM((IFNULL((SELECT 
                    SUM(aaa.actual_amount)
                FROM
                    pay_register_details aaa
                        JOIN
                    hrm_salary_head bb ON aaa.hrm_salary_head_id = bb.id
                        JOIN
                    hrm_salary_head_group cc ON bb.hrm_salary_head_group_id = cc.id
                        AND cc.generate_type = 1
                        AND bb.apply_for = 1
                WHERE
                    aaa.pay_register_id = aa.id),
            0) - IFNULL((SELECT 
                    SUM(aaa.actual_amount)
                FROM
                    pay_register_details aaa
                        JOIN
                    hrm_salary_head bb ON aaa.hrm_salary_head_id = bb.id
                        JOIN
                    hrm_salary_head_group cc ON bb.hrm_salary_head_group_id = cc.id
                        AND cc.generate_type = 2
                        AND bb.apply_for = 1
                WHERE
                    aaa.pay_register_id = aa.id),
            0)) * aa.by_bank_percent / 100) AS Net_Pay
FROM
    pay_register aa
        JOIN
    hrm_employee_job_info b ON aa.hrm_employee_job_info_id = b.id
        AND aa.hrm_employee_job_info_id = b.id
        AND aa.payment_mode = 2
        AND aa.salary_genarate_type <> 0
        JOIN
    hrm_employee a ON b.hrm_employee_id = a.id
        JOIN
    hrm_depertment c ON b.hrm_depertment_id = c.id
        JOIN
    hrm_designation e ON b.hrm_designation_id = e.id
        JOIN
    hrm_section f ON b.hrm_section_id = f.id
$P!{condition_parameter}
GROUP BY c.id , b.id ,    a.employee_name,
    c.depertment_name,
    aa.accounts_code,
    e.designation_name,
    aa.account_no,e.priority) aa
WHERE  aa.Net_Pay>0
Order By aa.section_name,aa.depertment_name,aa.priority,aa.employee_name]]>
	</queryString>
