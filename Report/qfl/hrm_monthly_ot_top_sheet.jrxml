	<parameter name="company_name" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="address" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="title" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="condition_parameter" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="condition_parameter1" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    aa.category_name,
    SUM(aa.count) AS count,
    SUM(aa.gross_salary) AS gross_salary,
    SUM(aa.basic_salary) AS basic_salary,
    SUM(aa.net_overtime) AS net_overtime,
    SUM(aa.total_amount) AS total_amount,
    SUM(aa.last_month_amount) AS last_month_amount
FROM
    (SELECT 
        e.category_name,
            COUNT(a.id) AS count,
            SUM(b.gross_salary) AS gross_salary,
            SUM(b.basic_salary) AS basic_salary,
         SUM((b.net_overtime * b.rate) / b.actual_ot_rate) as net_overtime,
            ROUND( SUM((b.net_overtime * b.rate)+b.addition_amt-b.deduction_amt)) AS total_amount,
            0 AS last_month_amount
    FROM
        hrm_ot_process_master a
    JOIN hrm_ot_process_details b ON a.id = b.hrm_ot_process_master_id
        AND a.process_status <> 0
    JOIN hrm_employee_job_info c ON b.hrm_employee_job_info_id = c.id
     $P!{condition_parameter} 
    JOIN hrm_employee d ON c.hrm_employee_id = d.id
    JOIN hrm_category e ON c.hrm_category_id = e.id
    GROUP BY e.id UNION ALL SELECT 
        e.category_name,
            0 AS count,
            0 AS gross_salary,
            0 AS basic_salary,
            0 AS net_overtime,
            0 AS total_amount,
            ROUND( SUM((b.net_overtime * b.rate)+b.addition_amt-b.deduction_amt)) AS last_month_amount
    FROM
        hrm_ot_process_master a
    JOIN hrm_ot_process_details b ON a.id = b.hrm_ot_process_master_id
        AND a.process_status <> 0
    JOIN hrm_employee_job_info c ON b.hrm_employee_job_info_id = c.id
     $P!{condition_parameter1} 
    JOIN hrm_employee d ON c.hrm_employee_id = d.id
    JOIN hrm_category e ON c.hrm_category_id = e.id
    GROUP BY e.id) aa
GROUP BY aa.category_name]]>
	</queryString>
