	<parameter name="increment_amount" class="java.lang.Double"/>
	<parameter name="pf" class="java.lang.Double"/>
	<parameter name="festival_bonus" class="java.lang.Double"/>
	<parameter name="exgratia_bonus" class="java.lang.Double"/>
	<queryString>
		<![CDATA[SELECT 
    aa.*,
    (aa.proposed_salary + aa.ExGratia_Bonus + aa.Revised_Structure + aa.two_festival_bonus + aa.pf + aa.transport_outOfPocket + aa.houseRent_allowance + aa.fixed_allowance + aa.insurance) AS Proposed_Cost_Company,
    (aa.proposed_salary + aa.ExGratia_Bonus + aa.Revised_Structure + aa.two_festival_bonus + aa.pf + aa.transport_outOfPocket + aa.houseRent_allowance + aa.fixed_allowance + aa.insurance) AS Existing_Cost_Company,
    ((proposed_salary - gross_salary) / gross_salary * 100) AS Percentage_On_Gross,
    0 AS Percentage_Cost_Company,
    '' AS Remarks
FROM
    (SELECT
	COUNT(b.id) as counts,
    h.category_name,
    c.location_name AS section_name,
    SUM(b.basic_salary) AS gross_salary,
    (SUM(b.basic_salary) * $P{increment_amount}) AS increment_salary,
    (SUM(b.basic_salary) + (SUM(b.basic_salary) * $P{increment_amount} )) AS proposed_salary,
    (((SUM(b.basic_salary) + (SUM(b.basic_salary) * $P{increment_amount})) * 0.60 * $P{exgratia_bonus})/ 12) AS ExGratia_Bonus,
    0 AS Revised_Structure,
    (((SUM(b.basic_salary) + (SUM(b.basic_salary) * $P{increment_amount})) *  $P{festival_bonus} * 2) / 12) AS two_festival_bonus,
    (((SUM(b.basic_salary) + (SUM(b.basic_salary) * $P{increment_amount})) * 0.60 *  $P{pf})) AS pf,
    IFNULL((SELECT 
                    SUM(bb.actual_amount)
                FROM
                    hrm_employee_salary aa
                        JOIN
                    hrm_employee_salary_details bb ON aa.id = bb.hrm_employee_salary_id
                        JOIN
                    hrm_employee_job_info b ON aa.hrm_employee_job_info_id = b.id
                    AND b.employee_activity = 1 AND b.hrm_employment_status_id NOT IN (3)
                    $P!{condition_parameter}
                WHERE
                    b.hrm_location_id = c.id AND b.hrm_category_id = h.id AND bb.hrm_salary_head_id IN (11 , 8)),
            0) AS transport_outOfPocket,
    IFNULL((SELECT 
                    SUM(bb.actual_amount)
                FROM
                    hrm_employee_salary aa
                        JOIN
                    hrm_employee_salary_details bb ON aa.id = bb.hrm_employee_salary_id
                        JOIN
                    hrm_employee_job_info b ON aa.hrm_employee_job_info_id = b.id
                    AND b.employee_activity = 1 AND b.hrm_employment_status_id NOT IN (3)
                    $P!{condition_parameter}
                WHERE
                    b.hrm_location_id = c.id AND b.hrm_category_id = h.id AND bb.hrm_salary_head_id IN (9)),
            0) AS houseRent_allowance,
    IFNULL((SELECT 
                    SUM(bb.actual_amount)
                FROM
                    hrm_employee_salary aa
                        JOIN
                    hrm_employee_salary_details bb ON aa.id = bb.hrm_employee_salary_id
                JOIN
                    hrm_employee_job_info b ON aa.hrm_employee_job_info_id = b.id
                    AND b.employee_activity = 1 AND b.hrm_employment_status_id NOT IN (3)
                    $P!{condition_parameter}
                WHERE
                    b.hrm_location_id = c.id AND b.hrm_category_id = h.id
                        AND bb.hrm_salary_head_id IN (12)),
            0) AS fixed_allowance,
    0 AS insurance
FROM
    hrm_employee a
        JOIN
    hrm_employee_job_info b ON a.id = b.hrm_employee_id
        AND b.employee_activity = 1 AND b.hrm_employment_status_id NOT IN (3)
        $P!{condition_parameter}
        JOIN
    hrm_location c ON b.hrm_location_id = c.id AND c.location_type in (1,2)
        JOIN
    hrm_depertment d ON b.hrm_depertment_id = d.id
        JOIN
    hrm_designation e ON b.hrm_designation_id = e.id
        JOIN
    hrm_employee_joining f ON b.hrm_employee_id = f.hrm_employee_id
        JOIN
    hrm_employment_status g ON b.hrm_employment_status_id = g.id
        JOIN
    hrm_category h ON b.hrm_category_id = h.id
        JOIN
    hrm_section i ON b.hrm_section_id = i.id
        JOIN
    hrm_education p ON p.id = a.hrm_education_id
GROUP BY h.category_name , c.location_name
UNION
SELECT
	COUNT(b.id) as counts,
    h.category_name,
    c.location_name AS section_name,
    SUM( IF(b.hrm_location_id=2,11180,10920)) AS gross_salary,
    0 AS increment_salary,
   SUM( IF(b.hrm_location_id=2,11180,10920)) AS proposed_salary,
    0 AS ExGratia_Bonus,
    0 AS Revised_Structure,
    0 AS two_festival_bonus,
    0 AS pf,
    0 AS transport_outOfPocket,
    0 AS houseRent_allowance,
    0 AS fixed_allowance,
    0 AS insurance
FROM
    hrm_employee a
        JOIN
    hrm_employee_job_info b ON a.id = b.hrm_employee_id
        AND b.employee_activity = 1 AND b.hrm_employment_status_id = 3
        $P!{condition_parameter}
        JOIN
    hrm_location c ON b.hrm_location_id = c.id AND c.location_type in (1,2)
        JOIN
    hrm_depertment d ON b.hrm_depertment_id = d.id
        JOIN
    hrm_designation e ON b.hrm_designation_id = e.id
        JOIN
    hrm_employee_joining f ON b.hrm_employee_id = f.hrm_employee_id
        JOIN
    hrm_employment_status g ON b.hrm_employment_status_id = g.id
        JOIN
    hrm_category h ON b.hrm_category_id = h.id
        JOIN
    hrm_section i ON b.hrm_section_id = i.id
        JOIN
    hrm_education p ON p.id = a.hrm_education_id
GROUP BY h.category_name , c.location_name

UNION

SELECT
    COUNT(b.id) as counts,
    h.category_name,
    'All Depot' AS section_name,
    SUM(b.basic_salary) AS gross_salary,
    (SUM(b.basic_salary) * $P{increment_amount}) AS increment_salary,
    (SUM(b.basic_salary) + (SUM(b.basic_salary) * $P{increment_amount} )) AS proposed_salary,
    (((SUM(b.basic_salary) + (SUM(b.basic_salary) * $P{increment_amount})) * 0.60 * $P{exgratia_bonus})/ 12) AS ExGratia_Bonus,
    0 AS Revised_Structure,
    (((SUM(b.basic_salary) + (SUM(b.basic_salary) * $P{increment_amount})) *  $P{festival_bonus} * 2) / 12) AS two_festival_bonus,
    (((SUM(b.basic_salary) + (SUM(b.basic_salary) * $P{increment_amount})) * 0.60 *  $P{pf} )) AS pf,
    IFNULL((SELECT 
                    SUM(bb.actual_amount)
                FROM
                    hrm_employee_salary aa
                        JOIN
                    hrm_employee_salary_details bb ON aa.id = bb.hrm_employee_salary_id
                JOIN
                    hrm_employee_job_info b ON aa.hrm_employee_job_info_id = b.id
                    AND b.employee_activity = 1 AND b.hrm_employment_status_id NOT IN (3)
                    $P!{condition_parameter}
                WHERE
                    b.hrm_location_id = c.id AND b.hrm_category_id = h.id AND bb.hrm_salary_head_id IN (11 , 8)),
            0) AS transport_outOfPocket,
    IFNULL((SELECT 
                    SUM(bb.actual_amount)
                FROM
                    hrm_employee_salary aa
                        JOIN
                    hrm_employee_salary_details bb ON aa.id = bb.hrm_employee_salary_id
                JOIN
                    hrm_employee_job_info b ON aa.hrm_employee_job_info_id = b.id
                    AND b.employee_activity = 1 AND b.hrm_employment_status_id NOT IN (3)
                    $P!{condition_parameter}
                WHERE
                    b.hrm_location_id = c.id AND b.hrm_category_id = h.id AND bb.hrm_salary_head_id IN (9)),
            0) AS houseRent_allowance,
    IFNULL((SELECT 
                    SUM(bb.actual_amount)
                FROM
                    hrm_employee_salary aa
                        JOIN
                    hrm_employee_salary_details bb ON aa.id = bb.hrm_employee_salary_id
                JOIN
                    hrm_employee_job_info b ON aa.hrm_employee_job_info_id = b.id
                    AND b.employee_activity = 1 AND b.hrm_employment_status_id NOT IN (3)
                    $P!{condition_parameter}
                WHERE
                    b.hrm_location_id = c.id AND b.hrm_category_id = h.id
                        AND bb.hrm_salary_head_id IN (12)),
            0) AS fixed_allowance,
    0 AS insurance
FROM
    hrm_employee a
        JOIN
    hrm_employee_job_info b ON a.id = b.hrm_employee_id
        AND b.employee_activity = 1 AND b.hrm_employment_status_id NOT IN (3)
        $P!{condition_parameter}
        JOIN
    hrm_location c ON b.hrm_location_id = c.id AND c.location_type=3
        JOIN
    hrm_depertment d ON b.hrm_depertment_id = d.id
        JOIN
    hrm_designation e ON b.hrm_designation_id = e.id
        JOIN
    hrm_employee_joining f ON b.hrm_employee_id = f.hrm_employee_id
        JOIN
    hrm_employment_status g ON b.hrm_employment_status_id = g.id
        JOIN
    hrm_category h ON b.hrm_category_id = h.id
        JOIN
    hrm_section i ON b.hrm_section_id = i.id
        JOIN
    hrm_education p ON p.id = a.hrm_education_id
GROUP BY h.category_name 
UNION
SELECT
    COUNT(b.id) as counts,
    h.category_name,
    'All Depot' AS section_name,
    SUM( IF(b.hrm_location_id=2,11180,10920)) AS gross_salary,
    0 AS increment_salary,
   SUM( IF(b.hrm_location_id=2,11180,10920)) AS proposed_salary,
    0 AS ExGratia_Bonus,
    0 AS Revised_Structure,
    0 AS two_festival_bonus,
    0 AS pf,
    0 AS transport_outOfPocket,
    0 AS houseRent_allowance,
    0 AS fixed_allowance,
    0 AS insurance
FROM
    hrm_employee a
        JOIN
    hrm_employee_job_info b ON a.id = b.hrm_employee_id
        AND b.employee_activity = 1 AND b.hrm_employment_status_id = 3
        $P!{condition_parameter}
        JOIN
    hrm_location c ON b.hrm_location_id = c.id AND c.location_type=3
        JOIN
    hrm_depertment d ON b.hrm_depertment_id = d.id
        JOIN
    hrm_designation e ON b.hrm_designation_id = e.id
        JOIN
    hrm_employee_joining f ON b.hrm_employee_id = f.hrm_employee_id
        JOIN
    hrm_employment_status g ON b.hrm_employment_status_id = g.id
        JOIN
    hrm_category h ON b.hrm_category_id = h.id
        JOIN
    hrm_section i ON b.hrm_section_id = i.id
        JOIN
    hrm_education p ON p.id = a.hrm_education_id
GROUP BY h.category_name 

















) aa
ORDER BY aa.section_name,aa.category_name]]>
	</queryString>
