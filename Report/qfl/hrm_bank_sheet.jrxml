<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="hrm_bank_sheet" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="9438248a-295f-40af-a669-de9baf60f08d">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/> 
	<property name="ireport.y" value="0"/>
	<parameter name="company_name" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="address" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="title" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="condition_parameter" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="condition_parameter_1" class="java.lang.String"/>
	<parameter name="hrm_month_id" class="java.lang.String"/>
	<parameter name="year_id" class="java.lang.String"/>
	<parameter name="bank_id" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    a.employee_name,c.depertment_name,concat('X',d.account_no) as  account_no,((aa.addition-bb.deduction)*d.by_bank_percent/100) as Net_Pay
FROM
    hrm_employee a
        JOIN
    hrm_employee_job_info b ON a.id = b.hrm_employee_id AND b.employee_activity=1 
        JOIN
	hrm_depertment c ON b.hrm_depertment_id=c.id
		JOIN
	hrm_employee_salary d ON d.hrm_employee_job_info_id=b.id AND d.payment_mode=2
        JOIN
    (SELECT
        SUM(b.actual_amount) AS addition, a.hrm_employee_job_info_id
    FROM
        pay_register a
    JOIN pay_register_details b ON a.id = b.pay_register_id AND a.salary_genarate_type<>0
    JOIN hrm_salary_head c ON b.hrm_salary_head_id = c.id
    JOIN hrm_salary_head_group d ON c.hrm_salary_head_group_id = d.id
        AND d.generate_type = 1
	    AND a.hrm_month_id = $P{hrm_month_id} And a.year_id = $P{year_id} And a.hrm_bank_id = $P{bank_id}
        Group By a.hrm_employee_job_info_id) aa ON aa.hrm_employee_job_info_id = b.id
        JOIN
    (SELECT
        SUM(e.actual_amount) AS deduction,
            a.hrm_employee_job_info_id
    FROM
        pay_register a
    JOIN pay_register_details e ON a.id = e.pay_register_id AND a.salary_genarate_type<>0
    JOIN hrm_salary_head f ON e.hrm_salary_head_id = f.id
    JOIN hrm_salary_head_group g ON f.hrm_salary_head_group_id = g.id
        AND g.generate_type = 2
	    AND a.hrm_month_id = $P{hrm_month_id} And a.year_id = $P{year_id} And a.hrm_bank_id = $P{bank_id}
        Group By a.hrm_employee_job_info_id) bb ON bb.hrm_employee_job_info_id = b.id
    $P!{condition_parameter}
    Group by c.id,a.id]]>
	</queryString>
	<field name="employee_name" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="depertment_name" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="account_no" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="Net_Pay" class="java.lang.Double"/>
	<variable name="Net_Pay_1" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{Net_Pay}]]></variableExpression>
	</variable>
