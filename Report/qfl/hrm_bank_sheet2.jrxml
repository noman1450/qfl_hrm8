	</field>
	<field name="account_3" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<variable name="Net_Pay_1" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{Net_Pay}]]></variableExpression>
	</variable>
