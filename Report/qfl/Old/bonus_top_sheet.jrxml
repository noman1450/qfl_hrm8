	<queryString>
		<![CDATA[SELECT
    e.id,
    e.priority,
    e.category_name,
    f.location_name,
    f.location_type,
    COUNT(DISTINCT a.id) AS noOfEmployee,
    IF(aa.payment_mode = 1,
        'Cash',
        h.short_name) bank_name,
    1 AS group_status,
    sum(Round(aa.bonus_amount,0)) as amount
FROM
    hrm_employee_bonus aa
        JOIN
    hrm_employee_job_info a ON aa.hrm_employee_job_info_id = a.id AND aa.is_valid=1
        JOIN
    hrm_employee_bonus_master b ON aa.hrm_employee_bonus_master_id = b.id and b.is_valid=1
        JOIN
    hrm_category e ON a.hrm_category_id = e.id
        JOIN
    hrm_location f ON b.hrm_location_id = f.id and f.location_type in (1,2)
       LEFT JOIN
    hrm_bank h ON aa.hrm_bank_id = h.id
     $P!{condition_parameter}
GROUP BY b.id,e.id ,e.priority, e.category_name , f.location_name , aa.payment_mode , h.short_name 


UNION ALL SELECT
    e.id,
    e.priority,
    e.category_name,
    f.location_name,
    f.location_type,
    0 AS noOfEmployee,
    'Basic Salary' group_name,
    2 AS group_status,
    sum(aa.basic_salary) as amount
FROM
    hrm_employee_bonus aa
        JOIN
    hrm_employee_job_info a ON aa.hrm_employee_job_info_id = a.id AND aa.is_valid=1
        JOIN
    hrm_employee_bonus_master b ON aa.hrm_employee_bonus_master_id = b.id and b.is_valid=1
        JOIN
    hrm_category e ON a.hrm_category_id = e.id
        JOIN
    hrm_location f ON b.hrm_location_id = f.id and f.location_type in (1,2)
       LEFT JOIN
    hrm_bank h ON aa.hrm_bank_id = h.id
     $P!{condition_parameter}
GROUP BY b.id,e.id ,e.priority, e.category_name , f.location_name , aa.payment_mode , h.short_name 
UNION ALL
