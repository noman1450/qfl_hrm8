	<queryString>
		<![CDATA[SELECT *,
 SUM(yyy.gross_salary + yyy.two_festival_bonus + yyy.pf_contribution + yyy.transport_outOfPocket + yyy.houseRent_allowance + yyy.fixed_allowance) AS existing_cost
 FROM(

SELECT 
aa.id,
aa.employee_name,
aa.designation_name,
aa.depertment_name,
'' as education_name,
aa.joining_date,
aa.confirmation_date,
aa.section_name,
aa.category_name,
aa.priority,
aa.gross_salary,
Round(((aa.basic_salary*2)/12),0) as two_festival_bonus,
aa.PF as pf_contribution,
IFNULL((SELECT 
	SUM(bbb.actual_amount)
FROM
	hrm_employee_salary aaa
JOIN hrm_employee_salary_details bbb ON aaa.id = bbb.hrm_employee_salary_id
WHERE
	aa.id = aaa.hrm_employee_job_info_id
		AND bbb.hrm_salary_head_id IN (11 , 8)), 0) AS transport_outOfPocket,
IFNULL((SELECT 
	SUM(bbb.actual_amount)
FROM
	hrm_employee_salary aaa
JOIN hrm_employee_salary_details bbb ON aaa.id = bbb.hrm_employee_salary_id
WHERE
	aa.id = aaa.hrm_employee_job_info_id
		AND bbb.hrm_salary_head_id IN (9)), 0) AS houseRent_allowance,         
IFNULL((SELECT 
	SUM(bbb.actual_amount)
FROM
	hrm_employee_salary aaa
JOIN hrm_employee_salary_details bbb ON aaa.id = bbb.hrm_employee_salary_id
WHERE
	aa.id = aaa.hrm_employee_job_info_id
		AND bbb.hrm_salary_head_id IN (12)), 0) AS fixed_allowance


FROM
(SELECT
	a.id,
    concat(e.employee_name,' | ',a.employee_code) as employee_name,
    f.depertment_name,
    g.alis as designation_name,
    a.basic_salary as gross_salary,
    aa.accounts_code,
    e.tin,
    h.joining_date,
    h.confirmation_date,
    aa.day_of_month,
    aa.total_present,
    (aa.day_of_month - aa.total_present) AS absent,
    IF(d.id = 1,
        SUM(b.actual_amount),
        0) AS basic_salary,
    IF(d.id = 4,
        SUM(b.actual_amount),
        0) AS medical_allowance,
	   IF(d.id = 5,
        SUM(b.actual_amount),
        0) AS house_rent,
		     IF(d.id = 14,
        SUM(b.actual_amount),
        0) AS others_addition,
          IF(d.id = 3,
        SUM(b.actual_amount),
        0) AS attendance_deduction,
       IF(d.id = 6,
        SUM(b.actual_amount),
        0) AS PF,
	     IF(d.id = 7,
        SUM(b.actual_amount),
        0) AS TDS,
		     IF(d.id = 15,
        SUM(b.actual_amount),
        0) AS others_deduction,
	     IF(d.id = 2,
        SUM(b.actual_amount),
        0) AS loan_advance,
        
    aa.payment_mode,
    aa.account_no,
    g.priority,
    i.section_name,
    i.id as section_id,
    a.employee_code,
    j.category_name
FROM
    pay_register aa
        JOIN
    hrm_employee_job_info a ON aa.hrm_employee_job_info_id = a.id
        AND aa.year_id =  $P{year_id} 
        AND aa.hrm_month_id =  $P{hrm_month_id} 
        JOIN
    pay_register_details b ON aa.id = b.pay_register_id
        JOIN
    hrm_salary_head c ON b.hrm_salary_head_id = c.id
        JOIN
    hrm_salary_head_group d ON c.hrm_salary_head_group_id = d.id
        JOIN
    hrm_employee e ON a.hrm_employee_id = e.id
        JOIN
    hrm_depertment f ON a.hrm_depertment_id = f.id
        JOIN
    hrm_designation g ON a.hrm_designation_id = g.id
        JOIN
    hrm_employee_joining h ON a.hrm_employee_id = h.hrm_employee_id
        JOIN
    hrm_section i ON a.hrm_section_id = i.id
		JOIN
	hrm_category j ON a.hrm_category_id = j.id

Where  aa.salary_genarate_type<>0 AND aa.apply_for = 1

 $P!{condition_parameter} 
 
GROUP BY a.id,d.id) aa
GROUP BY aa.id) yyy
group by yyy.id
order by yyy.section_name,yyy.priority
]]>
	</queryString>
