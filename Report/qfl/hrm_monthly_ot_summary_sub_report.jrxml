<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="hrm_monthly_ot_summary_sub_report" pageWidth="285" pageHeight="842" columnWidth="245" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="2de861fe-8146-49a3-92f2-4783b8d0c223">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="QFL HRM"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="214"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="777"/>
	<parameter name="condition_parameter" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    (SUM((b.net_overtime * b.rate)+ifnull(b.addition_amt,0)-ifnull(b.deduction_amt,0))) AS ac_total,
    IF(b.payment_mode = 1,
        'CASH',
        (SELECT 
                short_name
            FROM
                hrm_bank
            WHERE
                id = b.hrm_bank_id)) AS pay_mode
FROM
    hrm_ot_process_master a
        JOIN
    hrm_ot_process_details b ON a.id = b.hrm_ot_process_master_id
        JOIN
    hrm_employee_job_info c ON b.hrm_employee_job_info_id = c.id

AND a.hrm_location_id = 2
        AND a.hrm_month_id = 3
        AND a.year_id = 2024
        AND c.id IN (SELECT
            hrm_employee_job_info_id
        FROM
            hrm_employee_activity
        WHERE
            '2024-03-31' BETWEEN start_date AND end_date
                AND end_date IS NOT NULL
                AND hrm_employee_activity_status_id NOT IN (7 , 5) UNION ALL SELECT
            hrm_employee_job_info_id
        FROM
            hrm_employee_activity
        WHERE
            end_date IS NULL
                AND start_date <= '2024-03-31'
                AND hrm_employee_activity_status_id NOT IN (7 , 5) UNION ALL SELECT
            hrm_employee_job_info_id
        FROM
            hrm_employee_activity
        WHERE
            end_date BETWEEN '2024-3-01' AND '2024-03-31'
                AND end_date IS NOT NULL
                AND hrm_employee_activity_status_id NOT IN (7 , 5) UNION ALL SELECT
            hrm_employee_job_info_id
        FROM
            hrm_employee_activity
        WHERE
            end_date BETWEEN '2024-3-01' AND '2024-03-31'
                AND end_date IS NOT NULL
                AND hrm_employee_activity_status_id NOT IN (7 , 5))
GROUP BY b.hrm_bank_id,b.payment_mode]]>
	</queryString>
	<field name="ac_total" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.name" value="ac_total"/>
		<property name="com.jaspersoft.studio.field.label" value="ac_total"/>
	</field>
	<field name="pay_mode" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="pay_mode"/>
		<property name="com.jaspersoft.studio.field.label" value="pay_mode"/>
	</field>
	<variable name="ac_total_sum" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{ac_total}]]></variableExpression>
	</variable>
