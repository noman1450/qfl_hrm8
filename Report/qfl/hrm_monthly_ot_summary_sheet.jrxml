		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    c.employee_code,
    d.employee_name,
    f. alis as designation_name,
    h.section_name,
    g.joining_date,
    g.confirmation_date,
    b.gross_salary AS gross,
    b.basic_salary,
    b.net_overtime AS ac_net_overtime,
    b.rate AS as_rate,
    (b.net_overtime * b.rate) AS ac_total,
    b.actual_ot_rate,
    ((b.net_overtime * b.rate) / b.actual_ot_rate) AS ot_hour,
    b.addition_amt,
    b.deduction_amt,
    CONCAT(  ifnull(b.account_no,''),'-' , IF(b.payment_mode = 1,
        'CASH',
        (SELECT 
                short_name
            FROM
                hrm_bank
            WHERE
                id = b.hrm_bank_id))  ) as account_no
FROM
    hrm_ot_process_master a
        JOIN
    hrm_ot_process_details b ON a.id = b.hrm_ot_process_master_id
        JOIN
    hrm_employee_job_info c ON b.hrm_employee_job_info_id = c.id
 $P!{condition_parameter} 
        JOIN
    hrm_employee d ON c.hrm_employee_id = d.id
        JOIN
    hrm_depertment e ON c.hrm_depertment_id = e.id
        JOIN
    hrm_designation f ON c.hrm_designation_id = f.id
        JOIN
    hrm_employee_joining g ON d.id = g.hrm_employee_id
        JOIN
    hrm_section h ON c.hrm_section_id = h.id
ORDER BY h.section_name , f.priority,c.employee_code]]>
	</queryString>
