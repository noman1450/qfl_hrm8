	<parameter name="company_name" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="address" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="title" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="condition_parameter" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="hrm_month_id" class="java.lang.String"/>
	<parameter name="year_id" class="java.lang.String"/>
	<parameter name="salary_head" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    e.employee_name,
    f.alis as designation_name,
    d.location_name,
    IF(a.payment_mode = 1,
        b.actual_amount,
        0) AS cash_payble,
    IF(a.payment_mode = 2,
        b.actual_amount,
        0) AS bank_payble,
    b.actual_amount AS total_payable,
    f.priority,
    d.location_type
FROM
    pay_register a
        JOIN
    pay_register_details b ON a.id = b.pay_register_id
        AND a.hrm_month_id = $P{hrm_month_id}
        AND a.year_id = $P{year_id}
        AND a.apply_for = 2
       AND b.hrm_salary_head_id =  $P{salary_head} 
        AND a.salary_genarate_type <> 0
        JOIN
    hrm_employee_job_info c ON a.hrm_employee_job_info_id = c.id
        JOIN
    hrm_location d ON a.hrm_location_id = d.id
        JOIN
    hrm_employee e ON c.hrm_employee_id = e.id
        JOIN
    hrm_designation f ON c.hrm_designation_id = f.id
     $P!{condition_parameter} 
ORDER BY  d.location_type ,d.location_name, f.priority]]>
	</queryString>
