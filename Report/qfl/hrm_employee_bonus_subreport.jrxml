	<parameter name="condition_parameter" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    SUM(a.bonus_amount) as net_total,
    a.payment_mode,
    IF(a.payment_mode=1,'CASH',(SELECT short_name FROM hrm_bank where a.hrm_bank_id=hrm_bank.id)) as payment_mode_name

FROM
    hrm_employee_bonus_master aa
        JOIN
    hrm_employee_bonus a ON aa.id = a.hrm_employee_bonus_master_id
        AND aa.is_valid = 1
        AND a.is_valid = 1
        JOIN
    hrm_employee_job_info b ON a.hrm_employee_job_info_id = b.id
        JOIN
    hrm_employee c ON b.hrm_employee_id = c.id
        JOIN
    hrm_depertment d ON b.hrm_depertment_id = d.id
        JOIN
    hrm_location e ON b.hrm_location_id = e.id
        JOIN
    hrm_designation f ON b.hrm_designation_id = f.id
        JOIN
    hrm_section g ON b.hrm_section_id = g.id
		JOIN
	hrm_employee_joining h ON c.id=h.hrm_employee_id

GROUP BY a.payment_mode,a.hrm_bank_id]]>
	</queryString>
