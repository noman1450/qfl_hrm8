	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="200"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="788"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="HRM Local Database"/>
	<parameter name="company_name" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="address" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="title" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="condition_parameter" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="hrm_month_id" class="java.lang.String"/>
	<parameter name="year_id" class="java.lang.String"/>
	<parameter name="salary_head" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    d.location_name,
    g.salary_head,
	IF(h.generate_type=1,COUNT(a.id),0) as NoOFEmployee,
    
    IF(a.payment_mode = 1,
		IF(h.generate_type=1,SUM(b.actual_amount),SUM(-b.actual_amount)),
        0) AS cash_payble,
    IF(a.payment_mode = 2,
		IF(h.generate_type=1,SUM(b.actual_amount),SUM(-b.actual_amount)),
        0) AS bank_payble,
    IF(h.generate_type=1,SUM(b.actual_amount),SUM(-b.actual_amount)) as total_payable,
    d.location_type
FROM
    pay_register a
        JOIN
    pay_register_details b ON a.id = b.pay_register_id
         AND a.hrm_month_id = $P{hrm_month_id}
        AND a.year_id = $P{year_id}
        AND a.apply_for = 2
        AND a.salary_genarate_type <> 0
        JOIN
    hrm_employee_job_info c ON a.hrm_employee_job_info_id = c.id
        JOIN
    hrm_location d ON a.hrm_location_id = d.id
        JOIN
    hrm_employee e ON c.hrm_employee_id = e.id
        JOIN
    hrm_designation f ON c.hrm_designation_id = f.id
        JOIN
    hrm_salary_head g ON b.hrm_salary_head_id = g.id
		JOIN
	hrm_salary_head_group h ON g.hrm_salary_head_group_id=h.id 
     $P!{condition_parameter} 
GROUP BY d.location_name , g.salary_head , a.payment_mode , d.location_type,h.generate_type
Order BY  d.location_type,d.location_name]]>
	</queryString>
