	<queryString>
		<![CDATA[SELECT 
    e.employee_name,
    f.designation_name,
    d.location_name,
    IF(a.payment_mode = 1,
        b.actual_amount,
        0) AS cash_payble,
    IF(a.payment_mode = 2,
        b.actual_amount,
        0) AS bank_payble,
    b.actual_amount AS total_payable,
    f.priority,
    d.location_type
FROM
    pay_register a
        JOIN
    pay_register_details b ON a.id = b.pay_register_id
        AND a.apply_for = 2
        AND a.salary_genarate_type <> 0
        JOIN
    hrm_employee_job_info c ON a.hrm_employee_job_info_id = c.id
        JOIN
    hrm_location d ON a.hrm_location_id = d.id
        JOIN
    hrm_employee e ON c.hrm_employee_id = e.id
        JOIN
    hrm_designation f ON c.hrm_designation_id = f.id
ORDER BY d.location_type , f.priority]]>
	</queryString>
