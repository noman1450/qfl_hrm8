	<queryString>
		<![CDATA[SELECT 
    a.id,
    c.employee_name,
    d.depertment_name,
    f.designation_name,
    g.section_name,
    e.location_name,
    a.bonus_amount,
    CONCAT(a.amount, ' ', a.amount_type) AS amount_type,
    a.salary_amount,
    b.employee_code,
    h.joining_date,
    h.confirmation_date,
    a.account_no,
    f.priority,
    a.basic_salary
FROM
    hrm_employee_bonus_master aa
        JOIN
    hrm_employee_bonus a ON aa.id = a.hrm_employee_bonus_master_id
        AND aa.is_valid = 1
        AND a.is_valid = 1
        JOIN
    hrm_employee_job_info b ON a.hrm_employee_job_info_id = b.id
        JOIN
    hrm_employee c ON b.hrm_employee_id = c.id
        JOIN
    hrm_depertment d ON b.hrm_depertment_id = d.id
        JOIN
    hrm_location e ON b.hrm_location_id = e.id
        JOIN
    hrm_designation f ON b.hrm_designation_id = f.id
        JOIN
    hrm_section g ON b.hrm_section_id = g.id
		JOIN
	hrm_employee_joining h ON c.id=h.hrm_employee_id

	Order By   g.section_name,d.depertment_name, f.priority, b.employee_code]]>
	</queryString>
