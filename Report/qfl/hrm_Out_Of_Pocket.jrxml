	</parameter>
	<parameter name="condition_parameter" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="hrm_month_id" class="java.lang.String"/>
	<parameter name="year_id" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
   d.location_name,count(c.id) as NoOfEmployee,sum(b.actual_amount) as payble
FROM
    pay_register a
        JOIN
    pay_register_details b ON a.id = b.pay_register_id
        AND a.salary_genarate_type<>0 
        AND a.hrm_month_id = $P{hrm_month_id}
        AND a.year_id = $P{year_id}
        AND a.apply_for = 2
        AND b.hrm_salary_head_id = 11
        JOIN
    hrm_employee_job_info c ON a.hrm_employee_job_info_id = c.id
		JOIN
	hrm_location d ON a.hrm_location_id=d.id
$P!{condition_parameter}
Group By d.location_name]]>
	</queryString>
	<field name="location_name" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="NoOfEmployee" class="java.lang.Long"/>
	<field name="payble" class="java.lang.Double"/>
	<variable name="payble_1" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{payble}]]></variableExpression>
	</variable>
	<variable name="payble_2" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{payble}]]></variableExpression>
	</variable>
	<variable name="NoOfEmployee_1" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{NoOfEmployee}]]></variableExpression>
	</variable>
