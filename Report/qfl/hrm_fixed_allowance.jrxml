	</parameter>
	<parameter name="hrm_month_id" class="java.lang.String"/>
	<parameter name="year_id" class="java.lang.String"/>
	<parameter name="salary_head" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[Select aa.NoOfEmployee,aa.designation_name,aa.cash_payble,aa.bank_payble,SUM(aa.cash_payble+aa.bank_payble) as total_payable, aa.priority,aa.location_name,aa.location_type from (SELECT 
   count(e.id) as NoOfEmployee,f.designation_name,d.location_name,IF(a.payment_mode=1,sum(b.actual_amount),0) as cash_payble,IF(a.payment_mode=2,sum(b.actual_amount),0) as bank_payble,f.priority,d.location_type
FROM
    pay_register a
        JOIN
    pay_register_details b ON a.id = b.pay_register_id
        AND a.hrm_month_id = $P{hrm_month_id}
        AND a.year_id = $P{year_id}
        AND a.apply_for = 2
        AND b.hrm_salary_head_id =  $P{salary_head} 
        AND a.salary_genarate_type <>0
        JOIN
    hrm_employee_job_info c ON a.hrm_employee_job_info_id = c.id
		JOIN
	hrm_location d ON a.hrm_location_id=d.id
		JOIN
	hrm_employee e ON c.hrm_employee_id = e.id
		JOIN
	hrm_designation f ON c.hrm_designation_id=f.id
     $P!{condition_parameter}
     GROUP BY f.designation_name,d.location_name,f.priority,a.payment_mode,d.location_type
) aa
	GROUP BY aa.NoOfEmployee,aa.designation_name,aa.cash_payble,aa.bank_payble,aa.priority,aa.location_name,aa.location_type
     Order By aa.location_type,aa.location_name,aa.priority]]>
	</queryString>
