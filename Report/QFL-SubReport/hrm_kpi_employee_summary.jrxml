	<queryString>
		<![CDATA[SELECT  
    a.id,
    c.employee_name,
    b.employee_code,
    d.depertment_name,
    f.joining_date,
    f.confirmation_date,
    if(f.confirmation_date<aa.start_date,CONCAT(
	TIMESTAMPDIFF(YEAR,
	aa.start_date,
	DATE_ADD(aa.end_date, INTERVAL 1 DAY)),' y(s) ',
	MOD(TIMESTAMPDIFF(MONTH,
	aa.start_date,
	DATE_ADD(aa.end_date, INTERVAL 1 DAY)),
	12),' m(s)'),
    CONCAT(
	TIMESTAMPDIFF(YEAR,
	f.confirmation_date,
	DATE_ADD(aa.end_date, INTERVAL 1 DAY)),' y(s) ',
	MOD(TIMESTAMPDIFF(MONTH,
	f.confirmation_date,
	DATE_ADD(aa.end_date, INTERVAL 1 DAY)),
	12),' m(s)')) as evaluate_date,
    e.alis AS designation_name,
    	CONCAT(
	TIMESTAMPDIFF(YEAR,
	f.confirmation_date,
	aa.end_date),' y(s) ',
	MOD(TIMESTAMPDIFF(MONTH,
	f.confirmation_date,
	aa.end_date),
	12),' m(s)') as service_length,
    (SELECT MAX(promotion_date) FROM hrm_last_promotion  WHERE hrm_last_promotion.hrm_employee_id=c.id AND hrm_last_promotion.promotion_date<aa.end_date) as last_promotion_date,
    CONCAT(g.increment_amount,
            g.increment_amount_type) AS increment_amount,
    g.total_point,
    g.deduct_point,
    SUM(g.total_point - g.deduct_point) AS net_point,
    g.promotion_status,
    e.priority,
    b.basic_salary,

 IF(g.increment_amount_type='%', b.basic_salary+ (b.basic_salary*g.increment_amount*.01)*(IF(f.confirmation_date<aa.start_date,(TIMESTAMPDIFF(MONTH, aa.start_date, DATE_ADD(aa.end_date, INTERVAL 1 DAY))),(TIMESTAMPDIFF(MONTH, f.confirmation_date, DATE_ADD(aa.end_date, INTERVAL 1 DAY))) )/ (TIMESTAMPDIFF(MONTH, aa.start_date, DATE_ADD(aa.end_date, INTERVAL 1 DAY))))  ,b.basic_salary+(g.increment_amount)*(IF(f.confirmation_date<aa.start_date,(TIMESTAMPDIFF(MONTH, aa.start_date, DATE_ADD(aa.end_date, INTERVAL 1 DAY))),(TIMESTAMPDIFF(MONTH, f.confirmation_date, DATE_ADD(aa.end_date, INTERVAL 1 DAY))) )/ (TIMESTAMPDIFF(MONTH, aa.start_date, DATE_ADD(aa.end_date, INTERVAL 1 DAY))))) as increment_salary
FROM
    hrm_kpi_employee_master a
        JOIN
    hrm_kpi_assesment_date aa ON a.hrm_kpi_assesment_date_id = aa.id
        AND a.status = 2
        JOIN
    hrm_kpi_assesment_year bb ON aa.hrm_kpi_assesment_year_id = bb.id
        JOIN
    hrm_employee_job_info b ON a.hrm_employee_job_info_id = b.id
        AND a.valid = 1
        JOIN
    hrm_employee c ON b.hrm_employee_id = c.id
        JOIN
    hrm_depertment d ON b.hrm_depertment_id = d.id
        JOIN
    hrm_designation e ON b.hrm_designation_id = e.id
        JOIN
    hrm_employee_joining f ON c.id = f.hrm_employee_id
        JOIN
    hrm_kpi_employee_final_summary g ON a.id = g.hrm_kpi_employee_master_id
GROUP BY a.id , c.employee_name , b.employee_code , d.depertment_name , e.alis ,  g.increment_amount , g.increment_amount_type , g.total_point , g.deduct_point , g.promotion_status,f.joining_date,f.confirmation_date,e.priority, b.basic_salary
ORDER BY d.depertment_name,e.priority]]>
	</queryString>
