		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="date_range" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    a.punche_date,
    a.hrm_employee_id,
    concat(b.employee_name,' | ',f.alis,' | ',e.depertment_name,' | ',c.employee_code) as employee_name,
    d.location_name,
    j.section_name as section_name,
    f.designation_name,
    i.category_name,
    j.section_name as depertment_name,
    a.actual_overtime AS over_time,
     ((SUM(TIME_TO_SEC(a.actual_overtime)))/60) as otminute
    
FROM
    hrm_attendance a
        JOIN
    hrm_employee b ON a.hrm_employee_id = b.id
        JOIN
    hrm_employee_job_info c ON b.id = c.hrm_employee_id AND c.overtime_status=1
        JOIN
    hrm_location d ON c.hrm_location_id = d.id
        JOIN
    hrm_depertment e ON c.hrm_depertment_id = e.id
        JOIN
    hrm_designation f ON c.hrm_designation_id = f.id
        JOIN
    hrm_employee_joining g ON c.hrm_employee_id = g.hrm_employee_id
        JOIN
    hrm_employment_status h ON c.hrm_employment_status_id = h.id
        JOIN
    hrm_category i ON c.hrm_category_id = i.id
        JOIN
    hrm_section j ON c.hrm_section_id = j.id
   $P!{condition_parameter}
GROUP BY a.`hrm_employee_id` , a.punche_date]]>
	</queryString>
