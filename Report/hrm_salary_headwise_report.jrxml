	<parameter name="parameter" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    e.id,
    CONCAT( ifnull(e.employee_name,'') , ' | ',ifnull(g.alis,''), ' | ',ifnull(aa.accounts_code,''),ifnull( a.employee_code ,'') ) AS employee_name,
    f.depertment_name,
    g.alis AS designation_name,
    aa.accounts_code,
    SUM(b.actual_amount) amount,
    IF(d.generate_type = 1,
        'Addition',
        'Deduction') AS generate_type,
    c.salary_head,
    aa.payment_mode,
    aa.account_no,
    g.priority,
    i.section_name,
    i.id AS section_id,
    j.location_name
FROM
    pay_register aa
        JOIN
    hrm_employee_job_info a ON aa.hrm_employee_job_info_id = a.id
        AND aa.salary_genarate_type <> 0
        AND aa.apply_for = 1
            $P!{parameter}
        JOIN
    pay_register_details b ON aa.id = b.pay_register_id
        JOIN
    hrm_salary_head c ON b.hrm_salary_head_id = c.id  
        JOIN
    hrm_salary_head_group d ON c.hrm_salary_head_group_id = d.id
        JOIN
    hrm_employee e ON a.hrm_employee_id = e.id
        JOIN
    hrm_depertment f ON a.hrm_depertment_id = f.id
        JOIN
    hrm_designation g ON a.hrm_designation_id = g.id
        JOIN
    hrm_employee_joining h ON a.hrm_employee_id = h.hrm_employee_id
        JOIN
    hrm_section i ON a.hrm_section_id = i.id
        JOIN
    hrm_location j ON aa.hrm_location_id = j.id
    $P!{condition_parameter}
GROUP BY  aa.id , c.salary_head
ORDER BY i.section_name,g.priority , a.employee_code]]>
	</queryString>
