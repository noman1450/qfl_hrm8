	<parameter name="id" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    a.activity_date, a.point, b.file_type_name
FROM
    hrm_kpi_employee_mark_deduct a
        JOIN
    hrm_file_type b ON a.hrm_file_type_id = b.id
        AND a.hrm_kpi_employee_master_id = $P{id}
ORDER BY b.id]]>
	</queryString>
