	<parameter name="condition_parameter" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    b.id,
    a.id AS leave_app_id,
    a.applied,
    b.employee_name,
	g.depertment_name,
	h.designation_name,
	i.confirmation_date,
	i.joining_date,
    a.duration,
    c.leave_type,
    if(a.payment_mode=1,'With Pay','Without Pay') as payment_mode,
    (CASE
        WHEN a.duration = 1 THEN 0.50
        WHEN a.duration = 3 THEN 0.25
        ELSE (DATEDIFF(a.date_to, a.date_from) + 1)
    END) AS days,
    a.comment,
    CONCAT(a.date_from, '  to  ', a.date_to) AS date_range,
    j.leave_year,
    concat(j.date_from,' - ',j.date_to) as year_date_range,
    d.employee_code,
    k.location_name

FROM
    hrm_leave_application a
        JOIN
    hrm_employee b ON b.id = a.hrm_employee_id 
        AND b.active_status = 1 
        JOIN
    hrm_employee_leave_type c ON a.hrm_employee_leave_type_id = c.id
        JOIN
    hrm_employee_job_info d ON a.hrm_employee_id = d.hrm_employee_id
        AND d.id in (SELECT id FROM  hrm_employee_job_info
                                    WHERE id in (SELECT max(id) FROM hrm_employee_job_info 
                                    Group By hrm_employee_id) )

        JOIN
    hrm_leave_approve f ON f.hrm_leave_application_id = a.id
        AND f.action_type = 1
        AND f.forward = 2
        JOIN
    hrm_depertment g ON d.hrm_depertment_id = g.id
        JOIN
    hrm_designation h ON d.hrm_designation_id = h.id
        JOIN
    hrm_employee_joining i ON i.hrm_employee_id = d.hrm_employee_id
		JOIN
    hrm_leave_years j ON a.hrm_leave_years_id=j.id
		JOIN
	hrm_location k ON d.hrm_location_id = k.id
 $P!{condition_parameter} 
 Group By a.id
 Order By c.leave_type,a.date_from;]]>
	</queryString>
