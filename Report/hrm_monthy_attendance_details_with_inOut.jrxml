	<queryString>
		<![CDATA[SELECT 
	e.id,
    e.employee_name,
    b.employee_code,
    c.depertment_name,
    d.alis as designation,
    d.priority,
    a.punche_date,
    ifnull(LEFT(a.in_time,5),'00:00')  as in_time,
	ifnull(LEFT(a.out_time,5),'00:00')  as out_time,
    CONCAT(date_format(a.punche_date,'%d-%b'),' ',date_format(a.punche_date,'%a')) as date_name,
    a.late_time,
    a.overtime_time,
    a.comment,
    f.alies AS attendance_status,
    g.location_name
FROM
    hrm_attendance a 
        JOIN
    hrm_employee_job_info b ON a.hrm_employee_id = b.hrm_employee_id
 
        JOIN
    hrm_depertment c ON b.hrm_depertment_id = c.id
        JOIN
    hrm_designation d ON b.hrm_designation_id = d.id
        JOIN
    hrm_employee e ON a.hrm_employee_id = e.id
        JOIN
    hrm_attendance_status f ON a.attendance_status = f.id
        JOIN
    hrm_location g ON b.hrm_location_id = g.id
    $P!{condition_parameter}
ORDER BY d.priority ASC, a.punche_date ASC]]>
	</queryString>
