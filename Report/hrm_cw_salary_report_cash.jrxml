	<parameter name="title" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="condition_parameter" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="condition_parameter_1" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    a.id,
    c.employee_name,
    b.employee_code,
    d.depertment_name,
    f.designation_name,
    e.location_name,
    a.amount AS salary_amount,
    a.year_id,
    a.hrm_month_id,
    a.day_of_month,
    a.total_present,
    IF(a.day_of_month<=a.total_present, (a.amount * a.day_of_month)+aa.due_adjust-aa.adv_adjust, (a.amount * a.total_present)+aa.due_adjust-aa.adv_adjust) AS total_salary,
    h.plant_name,
    h.id AS plant_id,
    i.joining_date,
    j.section_name,
    f.priority,
    aa.adv_adjust,
    aa.due_adjust,
    if(a.payment_mode=1,'Cash',a.account_no) as payment_mode
     
FROM
    pay_register a
        JOIN
    hrm_employee_job_info b ON a.hrm_employee_job_info_id = b.id
        AND a.salary_genarate_type <> 0
        AND a.apply_for = 3
        $P!{condition_parameter_1}
		JOIN
	pay_register_cw aa ON aa.pay_register_id=a.id
        JOIN
    hrm_employee c ON b.hrm_employee_id = c.id
        JOIN
    hrm_depertment d ON b.hrm_depertment_id = d.id
        JOIN
    hrm_location e ON b.hrm_location_id = e.id
        JOIN
    hrm_designation f ON b.hrm_designation_id = f.id
        JOIN
	hrm_plant_with_section ff ON aa.hrm_plant_with_section_id = ff.id
		JOIN
    hrm_plant h ON ff.hrm_plant_id = h.id
        JOIN
    hrm_employee_joining i ON b.hrm_employee_id = i.hrm_employee_id
        JOIN
    hrm_section j ON b.hrm_section_id=j.id
$P!{condition_parameter}
Order By 
    j.section_name,
    f.priority,
b.employee_code]]>
	</queryString>
