	<queryString language="SQL">
		<![CDATA[SELECT 
    SUM(aaa.own_contribution) AS own_contribution,
    SUM(aaa.com_contribution) AS com_contribution,
    SUM(aaa.total_contribution) AS total_contribution,
    aaa.generate_type,
    aaa.salary_head,
    aaa.payment_mode,
    CONCAT(aaa.employee_name, ' | ' , aaa.employee_code) as employee_name,
    aaa.depertment_name,
    aaa.designation_name,
    aaa.alis,
    aaa.joining_date,
    aaa.confirmation_date,
    aaa.section_name,
    aaa.location_name,
    aaa.accounts_code,
    aaa.priority
FROM
    (SELECT 
        CONCAT(aa.year_id, '-', IF(LENGTH(aa.hrm_month_id) = 1, CONCAT('0', aa.hrm_month_id), aa.hrm_month_id), '-', '01') AS activity_date,
            m.accounts_code,
            b.actual_amount AS own_contribution,
            b.actual_amount AS com_contribution,
            (b.actual_amount + b.actual_amount) AS total_contribution,
            IF(d.generate_type = 1, 'Addition', 'Deduction') AS generate_type,
            c.salary_head,
            aa.payment_mode,
            aa.account_no,
            CONCAT(e.month_name, ' - ', aa.year_id) AS month_year,
            f.employee_code,
            g.employee_name,
            h.depertment_name,
            i.designation_name,
            i.alis,
            j.joining_date,
            j.confirmation_date,
            k.section_name,
            l.location_name,
            i.priority
    FROM
        pay_register aa
    JOIN hrm_employee_job_info a ON aa.hrm_employee_job_info_id = a.id
        AND aa.salary_genarate_type <> 0
        AND aa.apply_for = 1
    JOIN pay_register_details b ON aa.id = b.pay_register_id
        AND b.hrm_salary_head_id = 6
    JOIN hrm_salary_head c ON b.hrm_salary_head_id = c.id
    JOIN hrm_salary_head_group d ON c.hrm_salary_head_group_id = d.id
    JOIN hrm_month e ON aa.hrm_month_id = e.id
    JOIN hrm_employee_job_info f ON a.hrm_employee_id = f.hrm_employee_id
        AND f.id IN (SELECT 
            MAX(id)
        FROM
            hrm_employee_job_info
        WHERE
            hrm_employee_id = a.hrm_employee_id)
    JOIN hrm_employee g ON f.hrm_employee_id = g.id
    JOIN hrm_depertment h ON f.hrm_depertment_id = h.id
    JOIN hrm_designation i ON f.hrm_designation_id = i.id
    JOIN hrm_employee_joining j ON f.hrm_employee_id = j.hrm_employee_id
    JOIN hrm_section k ON f.hrm_section_id = k.id
    JOIN hrm_location l ON f.hrm_location_id = l.id
    JOIN hrm_employee_salary m ON f.id = m.hrm_employee_job_info_id
 $P!{condition_parameter}  ) aaa
 $P!{condition_parameter_1}
GROUP BY aaa.generate_type , aaa.salary_head , aaa.payment_mode , aaa.employee_code , aaa.employee_name , aaa.depertment_name , aaa.designation_name , aaa.alis , aaa.joining_date , aaa.confirmation_date , aaa.section_name , aaa.location_name,aaa.priority
Order By  aaa.depertment_name,aaa.priority]]>
	</queryString>
