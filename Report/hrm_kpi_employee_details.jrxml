<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="hrm_kpi_employee_details" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="12525be8-a4c6-45d8-94dd-0b4b2bd74cca">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="430"/>
	<parameter name="title" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="address" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="company_name" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="subquery_parameter" class="java.lang.String"/>
	<parameter name="id" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["/reports/hrm_qfl/report/"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    a.id,
    CONCAT(c.employee_name, ' | ', b.employee_code) AS employee_name,
    d.depertment_name,
    e.designation_name,
    dd.location_name,
    ee.joining_date,
    ee.confirmation_date,
    CONCAT(TIMESTAMPDIFF(YEAR,
                ee.confirmation_date,
                aa.end_date),
            ' y(s) ',
            MOD(TIMESTAMPDIFF(MONTH,
                    ee.confirmation_date,
                    aa.end_date),
                12),
            ' m(s)') AS jobduration,
    bb.description AS year,
    CONCAT('From :',
            aa.start_date,
            '  To :',
            aa.end_date) AS kpi_year,
    i.description AS task_name,
    g.description AS marks,
    g.point,
    j.task_type_name,
    a.comments,
    k.total_point,
    k.deduct_point,
    (k.total_point - k.deduct_point) AS net_point,
    CONCAT(k.increment_amount,
            k.increment_amount_type) AS increment_amount,
    k.promotion_status,
    (SELECT 
            MAX(promotion_date)
        FROM
            hrm_last_promotion
        WHERE
            hrm_last_promotion.hrm_employee_id = c.id
                AND hrm_last_promotion.promotion_date < aa.end_date) AS last_promotion_date
FROM
    hrm_kpi_employee_master a
        JOIN
    hrm_kpi_assesment_date aa ON a.hrm_kpi_assesment_date_id = aa.id
        AND a.id = $P{id}
        JOIN
    hrm_kpi_assesment_year bb ON aa.hrm_kpi_assesment_year_id = bb.id
        JOIN
    hrm_employee_job_info b ON a.hrm_employee_job_info_id = b.id
        AND a.valid = 1
        JOIN
    hrm_employee c ON b.hrm_employee_id = c.id
        JOIN
    hrm_depertment d ON b.hrm_depertment_id = d.id
        JOIN
    hrm_location dd ON b.hrm_location_id = dd.id
        JOIN
    hrm_designation e ON b.hrm_designation_id = e.id
        JOIN
    hrm_employee_joining ee ON c.id = ee.hrm_employee_id
        JOIN
    hrm_kpi_employee_details f ON a.id = f.hrm_kpi_employee_master_id
        JOIN
    hrm_kpi_marks g ON f.hrm_kpi_marks_id = g.id
        JOIN
    hrm_kpi_task_details h ON f.hrm_kpi_task_details_id = h.id
        JOIN
    hrm_kpi_task i ON h.hrm_kpi_task_id = i.id
        JOIN
    hrm_kpi_task_type j ON i.hrm_kpi_task_type_id = j.id
        JOIN
    hrm_kpi_employee_final_summary k ON a.id = k.hrm_kpi_employee_master_id
GROUP BY a.id , c.employee_name , b.employee_code , d.depertment_name , e.designation_name , ee.joining_date , 
ee.confirmation_date , bb.description , k.last_promotion_date , aa.start_date , aa.end_date , i.description , 
j.task_type_name , a.comments , k.total_point , k.deduct_point , k.increment_amount , k.increment_amount_type ,
 k.promotion_status,g.description,g.point
ORDER BY j.task_type_name]]>
	</queryString>
