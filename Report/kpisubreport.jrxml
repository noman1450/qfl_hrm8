	</field>
	<field name="total_increment_salary" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.name" value="total_increment_salary"/>
		<property name="com.jaspersoft.studio.field.label" value="total_increment_salary"/>
	</field>
	<variable name="NoOfEmployee1" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{NoOfEmployee}]]></variableExpression>
