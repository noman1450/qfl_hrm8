	<parameter name="hrm_month_id" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    b.employee_name,
    b.id,
    c.id,
    c.depertment_name,
    d.designation_name,
    d.alis,
    e.joining_date,
    g.card_code,
    aa.year_id,
    aa.hrm_month_id,
    concat(aa.total_present,' of ',aa.day_of_month) AS day_of_month,
    aa.account_no,
    f.salary,
    f.loan_advance,
    f.attendance,
    f.stamp,
    f.tax,
    f.fines,
    f.salary as total_salary,
    (f.loan_advance+f.attendance+f.stamp+f.tax+f.fines) as total_deduction,
    (f.salary-(f.loan_advance+f.attendance+f.stamp+f.tax+f.fines)) as net_salary,
    ((f.salary-(f.loan_advance+f.attendance+f.stamp+f.tax+f.fines))*(aa.by_bank_percent/100)) as bank_amount,
    ((f.salary-(f.loan_advance+f.attendance+f.stamp+f.tax+f.fines))*((100-aa.by_bank_percent)/100)) as cash_amount
    
FROM
    pay_register aa
        JOIN
    hrm_employee_job_info a ON aa.hrm_employee_job_info_id = a.id
        AND aa.year_id = $P{year_id}
        AND aa.hrm_month_id = $P{hrm_month_id}
        JOIN
    hrm_employee b ON a.hrm_employee_id = b.id
        JOIN
    hrm_depertment c ON a.hrm_depertment_id = c.id
        JOIN
    hrm_designation d ON a.hrm_designation_id = d.id
        JOIN
    hrm_employee_joining e ON e.hrm_employee_id = b.id
	$P!{condition_parameter}
        JOIN
    (SELECT 
        id,
            SUM(salary) AS salary,
            SUM(loan_advance) AS loan_advance,
            SUM(attendance) AS attendance,
            SUM(stamp) AS stamp,
            SUM(fines) AS fines,
            SUM(tax) AS tax
    FROM
        v_monthly_salary
    WHERE
        year_id = $P{year_id} AND hrm_month_id = $P{hrm_month_id}
    GROUP BY id) f ON aa.id = f.id
        JOIN
    hrm_employee_card_code g ON a.id = g.hrm_employee_job_info_id
ORDER BY c.depertment_name,b.employee_name
    
 ]]>
	</queryString>
