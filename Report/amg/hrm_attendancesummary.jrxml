		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="date_range" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT bb.employee_name,b.employee_code,d.location_name,e.depertment_name,f.alis as designation_name,i.category_name,j.section_name,f.priority,
SUM(a.Absent+a.Present+a.Leavess+a.halfDayleave+a.OSD+a.Late+a.Friday+a.Holiday+a.withoutpayleave+a.withoutpayhalfdayleavewithoutpay
+a.HolidayAgainstLeave+a.QuarterDayLeave+a.withoutpayQuarterDayLeave) as total_days,
SUM(a.Present+a.Leavess+a.halfDayleave+a.OSD+a.Late+a.Friday+a.Holiday+
a.HolidayAgainstLeave+a.QuarterDayLeave+(a.withoutpayhalfdayleavewithoutpay/2)+
(a.withoutpayQuarterDayLeave*.75)-a.withoutpayleave)
 as payable_days,
SUM(a.Absent) as Absent,(SUM(a.Present)+sum(a.halfDayleave*.50)+sum(a.QuarterDayLeave*.75)+sum(a.withoutpayhalfdayleavewithoutpay*.50)+sum(a.withoutpayQuarterDayLeave*.75)) as Present,SUM(a.Late) as Late,SUM(a.OSD) as OSD,SUM(a.Friday) as Friday,
SUM(a.Holiday) as Holiday,SUM(a.HolidayAgainstLeave) as HolidayAgainstLeave,
SUM((a.Leavess)+(a.halfDayleave/2)+(a.QuarterDayLeave/4)) as withPayLeaves,
SUM((a.withoutpayleave)+(a.withoutpayhalfdayleavewithoutpay/2)+(a.withoutpayQuarterDayLeave/4)) as withoutPayLeaves

FROM
(SELECT 
	a.hrm_employee_id,
    case when a.attendance_status = 1 THEN count(a.id) ELSE 0 END Absent,
    case when a.attendance_status = 2 THEN count(a.id) ELSE 0 END Present,
    case when a.attendance_status = 3 THEN count(a.id) ELSE 0 END Leavess,
    case when a.attendance_status = 4 THEN count(a.id) ELSE 0 END halfDayleave,
    case when a.attendance_status = 5 THEN count(a.id) ELSE 0 END OSD,
    case when a.attendance_status = 6 THEN count(a.id) ELSE 0 END Late,
    case when a.attendance_status = 7 THEN count(a.id) ELSE 0 END Friday,
    case when a.attendance_status = 8 THEN count(a.id) ELSE 0 END Holiday,   
	case when a.attendance_status = 9 THEN count(a.id) ELSE 0 END withoutpayleave,
    case when a.attendance_status = 10 THEN count(a.id) ELSE 0 END withoutpayhalfdayleavewithoutpay,
    case when a.attendance_status = 11 THEN count(a.id) ELSE 0 END HolidayAgainstLeave,
    case when a.attendance_status = 12 THEN count(a.id) ELSE 0 END QuarterDayLeave, 
    case when a.attendance_status = 13 THEN count(a.id) ELSE 0 END withoutpayQuarterDayLeave   
FROM
    hrm_attendance a 
    JOIN hrm_employee_job_info b ON a.hrm_employee_id=b.hrm_employee_id 
 $P!{date_range}
 $P!{condition_parameter}
GROUP BY a.hrm_employee_id,a.attendance_status) a
JOIN hrm_employee bb On a.hrm_employee_id=bb.id
JOIN hrm_employee_job_info b On bb.id=b.hrm_employee_id
Join hrm_location d On b.hrm_location_id=d.id
JOIN hrm_depertment e On b.hrm_depertment_id=e.id
Join hrm_designation f On b.hrm_designation_id=f.id
Join hrm_employee_joining g on b.hrm_employee_id=g.hrm_employee_id
Join hrm_employment_status h On b.hrm_employment_status_id=h.id
Join hrm_category i on b.hrm_category_id=i.id
Join hrm_section j on b.hrm_section_id=j.id
 $P!{condition_parameter}
GROUP BY bb.employee_name,b.employee_code,d.location_name,e.depertment_name,f.alis,i.category_name,j.section_name,f.priority
having SUM(a.Present+a.Leavess+a.halfDayleave+a.OSD+a.Late+a.Friday+a.Holiday+
a.HolidayAgainstLeave+a.QuarterDayLeave+(a.withoutpayhalfdayleavewithoutpay/2)+
(a.withoutpayQuarterDayLeave*.75)-a.withoutpayleave)>0
Order By j.section_name,f.priority]]>
	</queryString>
