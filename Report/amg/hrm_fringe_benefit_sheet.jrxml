	<queryString>
		<![CDATA[SELECT aa.id,aa.employee_name,aa.depertment_name,designation_name,accounts_code,tin,joining_date,confirmation_date,day_of_month,
aa.total_present,aa.absent,aa.section_name,aa.section_id,aa.payment_mode,aa.account_no,
    aa.priority,SUM(aa.fixed_allowance) as fixed_allowance,SUM(aa.outOfPocket) as outOfPocket,SUM(aa.house_rent_allowance) as house_rent_allowance,
SUM(aa.car_allowance) as car_allowance,SUM(aa.OutOfPocketDeduction) as OutOfPocketDeduction,SUM(aa.CarAllowanceDeduction) as CarAllowanceDeduction,SUM(aa.fixed_allowance+aa.outOfPocket+aa.house_rent_allowance+aa.car_allowance) as total_addition
,SUM(aa.OutOfPocketDeduction+aa.CarAllowanceDeduction) as total_deduction,SUM(aa.fixed_allowance+aa.outOfPocket+aa.house_rent_allowance+aa.car_allowance-aa.OutOfPocketDeduction-aa.CarAllowanceDeduction) as
net_total
FROM
(SELECT
	e.id,
    e.employee_name,
    f.depertment_name,
    g.alis as designation_name,
    aa.accounts_code,
    e.tin,
    h.joining_date,
    h.confirmation_date,
    aa.day_of_month,
    aa.total_present,
    (aa.day_of_month - aa.total_present) AS absent,
    IF(d.id = 12,
        SUM(b.actual_amount),
        0) AS fixed_allowance,
    IF(d.id = 16,
        SUM(b.actual_amount),
        0) AS outOfPocket,
	   IF(d.id = 15,
        SUM(b.actual_amount),
        0) AS house_rent_allowance,
		     IF(d.id = 14,
        SUM(b.actual_amount),
        0) AS car_allowance,
          IF(d.id = 17,
        SUM(b.actual_amount),
        0) AS OutOfPocketDeduction,
       IF(d.id = 13,
        SUM(b.actual_amount),
        0) AS CarAllowanceDeduction,
    aa.payment_mode,
    aa.account_no,
    g.priority,
    i.section_name,
    i.id as section_id
FROM
    pay_register aa
        JOIN
    hrm_employee_job_info a ON aa.hrm_employee_job_info_id = a.id
	 	AND aa.year_id = $P{year_id}
      AND aa.hrm_month_id = $P{hrm_month_id}
        JOIN
    pay_register_details b ON aa.id = b.pay_register_id
        JOIN
    hrm_salary_head c ON b.hrm_salary_head_id = c.id
        JOIN
    hrm_salary_head_group d ON c.hrm_salary_head_group_id = d.id
        JOIN
    hrm_employee e ON a.hrm_employee_id = e.id
        JOIN
    hrm_depertment f ON a.hrm_depertment_id = f.id
        JOIN
    hrm_designation g ON a.hrm_designation_id = g.id
        JOIN
    hrm_employee_joining h ON a.hrm_employee_id = h.hrm_employee_id
        JOIN
    hrm_section i ON a.hrm_section_id = i.id
 $P!{condition_parameter}
GROUP BY e.id,e.employee_name,  f.depertment_name, g.alis, aa.accounts_code, e.tin, h.joining_date, h.confirmation_date, aa.day_of_month, aa.total_present,aa.day_of_month,aa.total_present,d.id,  aa.payment_mode, aa.account_no, g.priority, i.section_name, i.id) aa
GROUP BY aa.id,aa.employee_name,aa.depertment_name,aa.designation_name,aa.accounts_code,aa.tin,aa.joining_date,aa.confirmation_date, aa.day_of_month, aa.total_present,aa.day_of_month,aa.total_present,aa.id,aa.payment_mode, aa.account_no,aa.priority,aa.section_name,aa.section_id
Order By aa.section_name,aa.aa.priority]]>
	</queryString>
