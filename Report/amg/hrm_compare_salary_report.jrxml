	</field>
	<field name="Bank_Net_Pay_pre" class="java.lang.Double"/>
	<field name="Cash_Net_Pay_pre" class="java.lang.Double"/>
	<field name="Bank_Net_Pay_Cur" class="java.lang.Double"/>
	<field name="Cash_Net_Pay_Cur" class="java.lang.Double"/>
	<variable name="Bank_Net_Pay_pre_1" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{Bank_Net_Pay_pre}]]></variableExpression>
	</variable>
	<variable name="Cash_Net_Pay_pre_1" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{Cash_Net_Pay_pre}]]></variableExpression>
	</variable>
	<variable name="Bank_Net_Pay_Cur_1" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{Bank_Net_Pay_Cur}]]></variableExpression>
	</variable>
	<variable name="Cash_Net_Pay_Cur_1" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{Cash_Net_Pay_Cur}]]></variableExpression>
	</variable>
	<variable name="previous_month_total" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Bank_Net_Pay_pre}+$F{Cash_Net_Pay_pre}]]></variableExpression>
	</variable>
	<variable name="current_month_total" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{Bank_Net_Pay_Cur}+$F{Cash_Net_Pay_Cur}]]></variableExpression>
	</variable>
