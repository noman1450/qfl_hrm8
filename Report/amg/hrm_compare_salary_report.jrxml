<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="hrm_compare_salary_report" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="9438248a-295f-40af-a669-de9baf60f08d">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="company_name" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="address" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="title" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="previous_parameter" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="current_parameter" class="java.lang.String"/>
	<parameter name="parameter" class="java.lang.String"/>
	<parameter name="previous_month_name" class="java.lang.String"/>
	<parameter name="current_month_name" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    c.depertment_name,sum(((aa.addition-bb.deduction)*d.by_bank_percent/100)) as Bank_Net_Pay_pre,sum(((aa.addition-bb.deduction)*(100-d.by_bank_percent)/100)) as Cash_Net_Pay_pre,sum(((cc.addition-dd.deduction)*d.by_bank_percent/100)) as Bank_Net_Pay_Cur,sum(((cc.addition-dd.deduction)*(100-d.by_bank_percent)/100)) as Cash_Net_Pay_Cur
FROM
    hrm_employee a
        JOIN
    hrm_employee_job_info b ON a.id = b.hrm_employee_id AND b.employee_activity=1
        JOIN
	hrm_depertment c ON b.hrm_depertment_id=c.id
		JOIN
	hrm_employee_salary d ON d.hrm_employee_job_info_id=b.id
        JOIN
    (SELECT
        SUM(b.actual_amount) AS addition, a.hrm_employee_job_info_id
    FROM
        pay_register a
    JOIN pay_register_details b ON a.id = b.pay_register_id AND a.salary_genarate_type<>0
    JOIN hrm_salary_head c ON b.hrm_salary_head_id = c.id
    JOIN hrm_salary_head_group d ON c.hrm_salary_head_group_id = d.id
        AND d.generate_type = 1
        $P!{previous_parameter}
        Group By a.hrm_employee_job_info_id) aa ON aa.hrm_employee_job_info_id = b.id
        JOIN
    (SELECT
        SUM(e.actual_amount) AS deduction,
            a.hrm_employee_job_info_id
    FROM
        pay_register a
    JOIN pay_register_details e ON a.id = e.pay_register_id AND a.salary_genarate_type<>0
    JOIN hrm_salary_head f ON e.hrm_salary_head_id = f.id
    JOIN hrm_salary_head_group g ON f.hrm_salary_head_group_id = g.id
        AND g.generate_type = 2
	$P!{previous_parameter}
        Group By a.hrm_employee_job_info_id) bb ON bb.hrm_employee_job_info_id = b.id
	  Left  JOIN
    (SELECT
        SUM(b.actual_amount) AS addition, a.hrm_employee_job_info_id
    FROM
        pay_register a
    JOIN pay_register_details b ON a.id = b.pay_register_id AND a.salary_genarate_type<>0
    JOIN hrm_salary_head c ON b.hrm_salary_head_id = c.id
    JOIN hrm_salary_head_group d ON c.hrm_salary_head_group_id = d.id
        AND d.generate_type = 1
	$P!{current_parameter}
        Group By a.hrm_employee_job_info_id) cc ON cc.hrm_employee_job_info_id = b.id
        Left  JOIN
    (SELECT
        SUM(e.actual_amount) AS deduction,
            a.hrm_employee_job_info_id
    FROM
        pay_register a
    JOIN pay_register_details e ON a.id = e.pay_register_id AND a.salary_genarate_type<>0
    JOIN hrm_salary_head f ON e.hrm_salary_head_id = f.id
    JOIN hrm_salary_head_group g ON f.hrm_salary_head_group_id = g.id
        AND g.generate_type = 2
	$P!{current_parameter}
        Group By a.hrm_employee_job_info_id) dd ON dd.hrm_employee_job_info_id = b.id
    Group by c.id]]>
	</queryString>
	<field name="depertment_name" class="java.lang.String">
