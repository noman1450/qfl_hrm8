	<queryString>
		<![CDATA[SELECT 
    aaaa.location_name,
    aaaa.section_name,
    SUM(aaaa.manpower) AS manpower,
	SUM(aaaa.gross_previous) AS gross_previous,
    SUM(aaaa.net_total_previous) AS net_total_previous,
    SUM(aaaa.current_manpower) AS current_manpower,
    SUM(aaaa.current_gross_amount) AS current_gross_amount,
    SUM(aaaa.current_additional_amount) AS current_additional_amount,
    SUM(aaaa.current_deduction_amount) AS current_deduction_amount,
    SUM(aaaa.current_netpayable) AS current_netpayable,
    SUM(aaaa.net_total_previous - aaaa.current_netpayable) AS comparative_amount
FROM
    (SELECT 
        aaa.location_name,
            aaa.section_name,
            COUNT(aaa.manpower) AS manpower,
			SUM(aaa.gross_previous) AS gross_previous,
            SUM(aaa.net_total_previous) AS net_total_previous,
            aaa.current_manpower AS current_manpower,
            SUM(aaa.current_gross_amount) AS current_gross_amount,
            SUM(aaa.current_additional_amount) AS current_additional_amount,
            SUM(aaa.current_deduction_amount) AS current_deduction_amount,
            SUM(aaa.current_netpayable) AS current_netpayable
    FROM
        (SELECT 
        aa.location_name,
            aa.section_name,
            aa.manpower,
			SUM(aa.basic_salary + aa.medical_allowance + aa.house_rent + aa.Transportation +  aa.other_allowances) AS gross_previous,
            SUM(aa.basic_salary + aa.medical_allowance + aa.house_rent + aa.Transportation + aa.others_addition + aa.other_allowances - aa.PF - aa.TDS - aa.others_deduction - aa.loan_advance - aa.attendance_deduction - aa.stamp) AS net_total_previous,
            0 AS current_manpower,
            0 AS current_gross_amount,
            0 AS current_additional_amount,
            0 AS current_deduction_amount,
            0 AS current_netpayable
    FROM
        (SELECT 
        e.location_name,
            i.section_name,
            aa.id AS manpower,
            IF(d.id = 1, SUM(b.actual_amount), 0) AS basic_salary,
            IF(d.id = 8, SUM(b.actual_amount), 0) AS medical_allowance,
            IF(d.id = 7, SUM(b.actual_amount), 0) AS house_rent,
            IF(d.id = 11, SUM(b.actual_amount), 0) AS other_allowances,
            IF(d.id = 18, SUM(b.actual_amount), 0) AS others_addition,
            IF(d.id = 3, SUM(b.actual_amount), 0) AS attendance_deduction,
            IF(d.id = 4, SUM(b.actual_amount), 0) AS PF,
            IF(d.id = 6, SUM(b.actual_amount), 0) AS TDS,
            IF(d.id = 5, SUM(b.actual_amount), 0) AS others_deduction,
            IF(d.id = 2, SUM(b.actual_amount), 0) AS loan_advance,
            IF(d.id = 9, SUM(b.actual_amount), 0) AS stamp,
            IF(d.id = 10, SUM(b.actual_amount), 0) AS Transportation,
            aa.payment_mode,
            i.id AS section_id,
            aa.by_bank_percent
    FROM
        pay_register aa
    JOIN hrm_employee_job_info a ON aa.hrm_employee_job_info_id = a.id
        AND aa.year_id = $P{pre_year_id} 
        AND aa.hrm_month_id = $P{pre_hrm_month_id} 
    JOIN pay_register_details b ON aa.id = b.pay_register_id
    JOIN hrm_salary_head c ON b.hrm_salary_head_id = c.id
    JOIN hrm_salary_head_group d ON c.hrm_salary_head_group_id = d.id
    JOIN hrm_location e ON aa.hrm_location_id = e.id
    JOIN hrm_section i ON a.hrm_section_id = i.id
        $P!{condition_parameter} 
    GROUP BY i.id , e.location_name , i.section_name , d.id , aa.payment_mode , aa.by_bank_percent , aa.id) aa
    GROUP BY aa.location_name , aa.section_name , aa.manpower) aaa
    GROUP BY aaa.location_name , aaa.section_name 
    
    UNION ALL 
    
    SELECT 
        aaa.location_name,
            aaa.section_name,
            aaa.manpower AS manpower,
            SUM(aaa.gross_previous) AS gross_previous,
            SUM(aaa.net_total_previous) AS net_total_previous,
            COUNT(aaa.current_manpower) AS current_manpower,
            SUM(aaa.current_gross_amount) AS current_gross_amount,
            SUM(aaa.current_additional_amount) AS current_additional_amount,
            SUM(aaa.current_deduction_amount) AS current_deduction_amount,
            SUM(aaa.current_netpayable) AS current_netpayable
    FROM
        (SELECT 
        aa.location_name,
            aa.section_name,
            0 AS manpower,
            0 AS gross_previous,
            0 AS net_total_previous,
            aa.manpower AS current_manpower,
            SUM(aa.basic_salary + aa.medical_allowance + aa.house_rent + aa.Transportation + aa.other_allowances) AS current_gross_amount,
            SUM(aa.others_addition) AS current_additional_amount,
            SUM(aa.PF + aa.TDS + aa.others_deduction + aa.loan_advance + aa.attendance_deduction + aa.stamp) AS current_deduction_amount,
            SUM(aa.basic_salary + aa.medical_allowance + aa.house_rent + aa.Transportation + aa.others_addition + aa.other_allowances - aa.PF - aa.TDS - aa.others_deduction - aa.loan_advance - aa.attendance_deduction - aa.stamp) AS current_netpayable
    FROM
        (SELECT 
        e.location_name,
            i.section_name,
            aa.id AS manpower,
            IF(d.id = 1, SUM(b.actual_amount), 0) AS basic_salary,
            IF(d.id = 8, SUM(b.actual_amount), 0) AS medical_allowance,
            IF(d.id = 7, SUM(b.actual_amount), 0) AS house_rent,
            IF(d.id = 11, SUM(b.actual_amount), 0) AS other_allowances,
            IF(d.id = 18, SUM(b.actual_amount), 0) AS others_addition,
            IF(d.id = 3, SUM(b.actual_amount), 0) AS attendance_deduction,
            IF(d.id = 4, SUM(b.actual_amount), 0) AS PF,
            IF(d.id = 6, SUM(b.actual_amount), 0) AS TDS,
            IF(d.id = 5, SUM(b.actual_amount), 0) AS others_deduction,
            IF(d.id = 2, SUM(b.actual_amount), 0) AS loan_advance,
            IF(d.id = 9, SUM(b.actual_amount), 0) AS stamp,
            IF(d.id = 10, SUM(b.actual_amount), 0) AS Transportation,
            aa.payment_mode,
            i.id AS section_id,
            aa.by_bank_percent
    FROM
        pay_register aa
    JOIN hrm_employee_job_info a ON aa.hrm_employee_job_info_id = a.id
        AND aa.year_id = $P{year_id} 
        AND aa.hrm_month_id =   $P{hrm_month_id} 
    JOIN pay_register_details b ON aa.id = b.pay_register_id
    JOIN hrm_salary_head c ON b.hrm_salary_head_id = c.id
    JOIN hrm_salary_head_group d ON c.hrm_salary_head_group_id = d.id
    JOIN hrm_location e ON aa.hrm_location_id = e.id
    JOIN hrm_section i ON a.hrm_section_id = i.id
          $P!{condition_parameter} 
    GROUP BY i.id , e.location_name , i.section_name , d.id , aa.payment_mode , aa.by_bank_percent , aa.id) aa
    GROUP BY aa.location_name , aa.section_name , aa.manpower) aaa
    GROUP BY aaa.location_name , aaa.section_name) aaaa
GROUP BY aaaa.location_name , aaaa.section_name]]>
	</queryString>
