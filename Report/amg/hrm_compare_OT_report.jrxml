		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="depertment_name" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="previous" class="java.math.BigDecimal"/>
	<field name="present" class="java.math.BigDecimal"/>
	<variable name="previous_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{previous}]]></variableExpression>
	</variable>
	<variable name="present_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{present}]]></variableExpression>
	</variable>
