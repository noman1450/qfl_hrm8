<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="hrm_compare_OT_report" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="9438248a-295f-40af-a669-de9baf60f08d">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="company_name" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="address" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="title" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="previous_parameter" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="current_parameter" class="java.lang.String"/>
	<parameter name="parameter" class="java.lang.String"/>
	<parameter name="previous_month_name" class="java.lang.String"/>
	<parameter name="current_month_name" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT aa.id,aa.depertment_name,SUM(aa.previous) as previous,SUM(aa.current) as present
FROM(
SELECT
	d.id,
    d.depertment_name,
    convert(((TIME_FORMAT(SEC_TO_TIME(SUM(TIME_TO_SEC(e.overtime_time))),'%H')*Round(((b.basic_salary/COUNT(d.id))/ ROUND(TIME_FORMAT(g.working_hours, '%H')))))),decimal)  as previous,
    0 as current
FROM
    hrm_employee a
        JOIN
    hrm_employee_job_info b ON a.id = b.hrm_employee_id
        AND b.employee_activity = 1
        AND b.overtime_status = 1
	$P!{parameter}
    JOIN
    hrm_designation c ON b.hrm_designation_id = c.id
        JOIN
    hrm_depertment d ON b.hrm_depertment_id = d.id
        JOIN
    hrm_attendance e ON a.id = e.hrm_employee_id
        JOIN
    hrm_employee_shift f ON b.id = f.hrm_employee_job_info_id and f.end_date is null
        JOIN
    hrm_shift g ON f.hrm_shift_id = g.id
       $P!{previous_parameter}
GROUP BY d.depertment_name,a.id
UNION
SELECT
	d.id,
    d.depertment_name,
    0 as previous,
    convert(((TIME_FORMAT(SEC_TO_TIME(SUM(TIME_TO_SEC(e.overtime_time))),'%H')*Round(((b.basic_salary/COUNT(d.id))/ ROUND(TIME_FORMAT(g.working_hours, '%H')))))),decimal)  as current
FROM
    hrm_employee a
        JOIN
    hrm_employee_job_info b ON a.id = b.hrm_employee_id
        AND b.employee_activity = 1
        AND b.overtime_status = 1
	$P!{parameter}
    JOIN
    hrm_designation c ON b.hrm_designation_id = c.id
        JOIN
    hrm_depertment d ON b.hrm_depertment_id = d.id
        JOIN
    hrm_attendance e ON a.id = e.hrm_employee_id
        JOIN
    hrm_employee_shift f ON b.id = f.hrm_employee_job_info_id and f.end_date is null
        JOIN
    hrm_shift g ON f.hrm_shift_id = g.id
       $P!{current_parameter}
GROUP BY d.depertment_name,a.id
) aa

GROUP BY aa.depertment_name,aa.id]]>
	</queryString>
