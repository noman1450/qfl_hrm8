	<parameter name="bank_id" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT * FROM(
SELECT
    c.id,e.priority,a.employee_name,aa.account_no,e.designation_name,f.section_name as depertment_name,

 SUM(( IFNULL((SELECT 
                    SUM(aaa.actual_amount)
                FROM
                    pay_register_details aaa
                        JOIN
                    hrm_salary_head bb ON aaa.hrm_salary_head_id = bb.id
                        JOIN
                    hrm_salary_head_group cc ON bb.hrm_salary_head_group_id = cc.id
                        AND cc.generate_type = 1 AND bb.apply_for=1
                WHERE
                    aaa.pay_register_id = aa.id),0)-IFNULL((SELECT 
                    SUM(aaa.actual_amount)
                FROM
                    pay_register_details aaa
                        JOIN
                    hrm_salary_head bb ON aaa.hrm_salary_head_id = bb.id
                        JOIN
                    hrm_salary_head_group cc ON bb.hrm_salary_head_group_id = cc.id
                        AND cc.generate_type = 2 AND bb.apply_for=1
                WHERE
                    aaa.pay_register_id = aa.id),0))* aa.by_bank_percent/100 ) as Net_Pay
    
FROM
 
	pay_register aa 
        JOIN
    hrm_employee_job_info b ON aa.hrm_employee_job_info_id = b.id AND aa.hrm_employee_job_info_id=b.id AND aa.payment_mode=2 AND aa.salary_genarate_type<>0
		JOIN
	hrm_employee a ON b.hrm_employee_id=a.id
        JOIN
	hrm_depertment c ON b.hrm_depertment_id=c.id
		JOIN
	hrm_designation e ON b.hrm_designation_id=e.id
		JOIN
	hrm_section f ON b.hrm_section_id=f.id
    $P!{condition_parameter}
    Group by f.id,b.id,a.employee_name,aa.account_no,e.designation_name,e.priority,f.section_name
    ORDER BY  f.id,e.priority) aa
    WHERE aa.Net_Pay>0]]>
	</queryString>
