	<queryString>
		<![CDATA[SELECT aa.id,aa.employee_name,aa.depertment_name,designation_name,accounts_code,tin,joining_date,confirmation_date,day_of_month,
aa.total_present,aa.absent,aa.section_name,aa.section_id,aa.payment_mode,aa.account_no,
    aa.priority,SUM(aa.basic_salary) as basic_salary,SUM(aa.medical_allowance) as medical_allowance,SUM(aa.house_rent) as house_rent,
  SUM(aa.other_allowances) as other_allowances,SUM(aa.others_addition) as others_addition,SUM(aa.PF) as PF,SUM(aa.TDS) as TDS,SUM(aa.others_deduction) as others_deduction,SUM(aa.stamp) as stamp,SUM(aa.Transportation) as Transportation,
SUM(aa.loan_advance) as loan_advance,SUM(aa.attendance_deduction) as attendance_deduction, SUM(aa.basic_salary+aa.medical_allowance+aa.house_rent+aa.Transportation+aa.other_allowances) as gross_total,SUM(aa.basic_salary+aa.medical_allowance+aa.house_rent+aa.Transportation+aa.others_addition+aa.other_allowances) as total_addition
,SUM(aa.PF+aa.TDS+aa.others_deduction+aa.loan_advance+aa.attendance_deduction+aa.stamp) as total_deduction,SUM(aa.basic_salary+aa.medical_allowance+aa.house_rent+aa.Transportation+aa.others_addition+aa.other_allowances-aa.PF-aa.TDS-aa.others_deduction-aa.loan_advance-aa.attendance_deduction-aa.stamp) as
net_total,(SUM(aa.basic_salary+aa.medical_allowance+aa.house_rent+aa.Transportation+aa.others_addition+aa.other_allowances-aa.PF-aa.TDS-aa.others_deduction-aa.loan_advance-aa.attendance_deduction-aa.stamp)*aa.by_bank_percent/100) as bank_amount, (SUM(aa.basic_salary+aa.medical_allowance+aa.house_rent+aa.Transportation+aa.others_addition+aa.other_allowances-aa.PF-aa.TDS-aa.others_deduction-aa.loan_advance-aa.attendance_deduction-aa.stamp)*(100-aa.by_bank_percent)/100) as cash_amount,aa.employee_code,aa.by_bank_percent
FROM
(SELECT
	e.id,
    e.employee_name as employee_name,
    f.depertment_name,
    g.alis as designation_name,
    a.employee_code as accounts_code,
    e.tin,
    h.joining_date,
    h.confirmation_date,
    aa.day_of_month,
    aa.total_present,
    (aa.day_of_month - aa.total_present) AS absent,
    IF(d.id = 1,
        SUM(b.actual_amount),
        0) AS basic_salary,
    IF(d.id = 8,
        SUM(b.actual_amount),
        0) AS medical_allowance,
	   IF(d.id =7,
        SUM(b.actual_amount),
        0) AS house_rent,
		IF(d.id = 11,
        SUM(b.actual_amount),
        0) AS other_allowances,
		     IF(d.id = 18,
        SUM(b.actual_amount),
        0) AS others_addition,
          IF(d.id = 3,
        SUM(b.actual_amount),
        0) AS attendance_deduction,
       IF(d.id = 4,
        SUM(b.actual_amount),
        0) AS PF,
	     IF(d.id = 6,
        SUM(b.actual_amount),
        0) AS TDS,
		     IF(d.id = 5,
        SUM(b.actual_amount),
        0) AS others_deduction,
	     IF(d.id = 2,
        SUM(b.actual_amount),
        0) AS loan_advance,
         IF(d.id = 9,
        SUM(b.actual_amount),
        0) AS stamp,
        IF(d.id = 10,
        SUM(b.actual_amount),
        0) AS Transportation,
    aa.payment_mode,
    aa.account_no,
    g.priority,
    i.section_name,
    i.id as section_id,
    a.employee_code,
    aa.by_bank_percent
FROM
    pay_register aa
        JOIN
    hrm_employee_job_info a ON aa.hrm_employee_job_info_id = a.id
        AND aa.year_id =   $P{year_id} 
        AND aa.hrm_month_id =   $P{hrm_month_id} 

        JOIN
    pay_register_details b ON aa.id = b.pay_register_id
        JOIN
    hrm_salary_head c ON b.hrm_salary_head_id = c.id
        JOIN
    hrm_salary_head_group d ON c.hrm_salary_head_group_id = d.id
        JOIN
    hrm_employee e ON a.hrm_employee_id = e.id
        JOIN
    hrm_depertment f ON a.hrm_depertment_id = f.id
        JOIN
    hrm_designation g ON a.hrm_designation_id = g.id
        JOIN
    hrm_employee_joining h ON a.hrm_employee_id = h.hrm_employee_id
        JOIN
    hrm_section i ON a.hrm_section_id = i.id
     $P!{condition_parameter} 
GROUP BY e.id,e.employee_name,a.employee_code,f.depertment_name, g.alis, e.tin, h.joining_date, h.confirmation_date, aa.day_of_month, aa.total_present,aa.day_of_month,aa.total_present,d.id,  aa.payment_mode, aa.account_no, g.priority, i.section_name, i.id,aa.by_bank_percent) aa
GROUP BY aa.id,aa.employee_name,aa.depertment_name,aa.designation_name,aa.accounts_code,aa.tin,aa.joining_date,aa.confirmation_date, aa.day_of_month, aa.total_present,aa.day_of_month,aa.total_present,aa.id,aa.payment_mode, aa.account_no,aa.priority,aa.section_name,aa.section_id,aa.employee_code,aa.by_bank_percent
Order By aa.section_name,aa.depertment_name,aa.priority,aa.employee_name]]>
	</queryString>
