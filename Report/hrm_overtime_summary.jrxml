	<parameter name="company_name" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="address" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="title" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="condition_parameter" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT * FROM(
SELECT 
    e.employee_name,
    c.employee_code,
    cc.depertment_name,
    d.alis AS designation_name,
    d.priority,
    g.location_name,
    j.section_name,
    TIME_FORMAT(SEC_TO_TIME( SUM(TIME_TO_SEC(a.overtime_time))),'%H:%i') AS actual_overtime,
    ((SUM(TIME_TO_SEC(a.overtime_time)))/60) AS total_ot
    
FROM
    hrm_attendance a
        JOIN
    hrm_employee_job_info c ON a.hrm_employee_id = c.hrm_employee_id
        AND c.overtime_status = 1
        JOIN
    hrm_depertment cc ON c.hrm_depertment_id = cc.id
        JOIN
    hrm_designation d ON c.hrm_designation_id = d.id
        JOIN
    hrm_employee e ON c.hrm_employee_id = e.id
        JOIN
    hrm_location g ON c.hrm_location_id = g.id
        JOIN
    hrm_section j ON j.id = c.hrm_section_id
         $P!{condition_parameter} 
GROUP BY c.id)  aa
WHERE aa.actual_overtime>'00:00:00'
ORDER BY aa.section_name,aa.depertment_name,aa.employee_code]]>
	</queryString>
