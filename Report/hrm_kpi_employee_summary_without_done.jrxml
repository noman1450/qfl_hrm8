	</parameter>
	<parameter name="date_range" class="java.lang.String"/>
	<parameter name="date_id" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT 
        b.id,
		c.employee_name,
		b.employee_code,
		d.depertment_name,
		f.joining_date,
		f.confirmation_date,
		if(f.confirmation_date<(SELECT start_date FROM  hrm_kpi_assesment_date  WHERE id =  $P{date_id}),CONCAT(
		TIMESTAMPDIFF(YEAR,
		 (SELECT start_date FROM  hrm_kpi_assesment_date  WHERE id = $P{date_id}),
		DATE_ADD((SELECT end_date FROM  hrm_kpi_assesment_date  WHERE id = $P{date_id}), INTERVAL 1 DAY)),' y(s) ',
		MOD(TIMESTAMPDIFF(MONTH,
		(SELECT start_date FROM  hrm_kpi_assesment_date  WHERE id = $P{date_id}),
		DATE_ADD((SELECT end_date FROM  hrm_kpi_assesment_date  WHERE id = $P{date_id}), INTERVAL 1 DAY)),
		12),' m(s)'),
		CONCAT(
		TIMESTAMPDIFF(YEAR,
		f.confirmation_date,
		DATE_ADD((SELECT end_date FROM  hrm_kpi_assesment_date  WHERE id = $P{date_id}), INTERVAL 1 DAY)),' y(s) ',
		MOD(TIMESTAMPDIFF(MONTH,
		f.confirmation_date,
		DATE_ADD((SELECT end_date FROM  hrm_kpi_assesment_date  WHERE id = $P{date_id}), INTERVAL 1 DAY)),
		12),' m(s)')) as evaluate_date,
		e.alis AS designation_name,
			CONCAT(
		TIMESTAMPDIFF(YEAR,
		f.confirmation_date,
		(SELECT end_date FROM  hrm_kpi_assesment_date  WHERE id = $P{date_id})),' y(s) ',
		MOD(TIMESTAMPDIFF(MONTH,
		f.confirmation_date,
		(SELECT end_date FROM  hrm_kpi_assesment_date  WHERE id = $P{date_id})),
		12),' m(s)') as service_length,
        
		(SELECT MAX(promotion_date) FROM hrm_last_promotion  WHERE hrm_last_promotion.hrm_employee_id=c.id AND hrm_last_promotion.promotion_date<(SELECT end_date FROM  hrm_kpi_assesment_date  WHERE id = $P{date_id})) as last_promotion_date,
        '-' AS increment_amount,
		0 as total_point,
		0 as deduct_point,
		0 AS net_point,
		'N/A' promotion_status,
		e.priority,
		b.basic_salary,
	    0 as increment_amt,
	    b.basic_salary as increment_salary,
	    '' as note
FROM
    hrm_employee_job_info b
        JOIN
    hrm_employee c ON b.hrm_employee_id = c.id
        AND b.employee_activity = 1
        AND b.hrm_employee_id NOT IN 

        (        SELECT 
            b.hrm_employee_id
        FROM
            hrm_kpi_employee_master a 
            JOIN hrm_employee_job_info b ON a.hrm_employee_job_info_id=b.id
        WHERE a.hrm_kpi_assesment_date_id = $P{date_id}
)



            and b.hrm_employment_status_id in (1,2,4)
        JOIN
    hrm_depertment d ON b.hrm_depertment_id = d.id
        JOIN
    hrm_designation e ON b.hrm_designation_id = e.id
        JOIN
    hrm_employee_joining f ON c.id = f.hrm_employee_id
        AND f.joining_date <= (SELECT 
            end_date
        FROM
            hrm_kpi_assesment_date
        WHERE
            id = $P{date_id})
             $P!{condition_parameter}
             
ORDER BY d.depertment_name,e.priority]]>
	</queryString>
