	</parameter>
	<queryString>
		<![CDATA[SELECT 
    CONCAT(b.employee_name, ' | ', c.employee_code) AS employee_name,
    e.depertment_name,
    a.punch_date,
    a.punch_time,
    g.shift_name,
    ee.alis
FROM
    hrm_attendance_raw_data a
        JOIN
    hrm_employee b ON a.hrm_employee_id = b.id 
        JOIN
    hrm_employee_job_info c ON b.id = c.hrm_employee_id
        AND a.hrm_location_id = c.hrm_location_id
        AND c.id IN (SELECT 
            MAX(id)
        FROM
            hrm_employee_job_info
        GROUP BY hrm_employee_id)
        AND a.is_new = 1
        AND a.valid = 1
        JOIN
    hrm_location d ON c.hrm_location_id = d.id
        JOIN
    hrm_depertment e ON c.hrm_depertment_id = e.id
		JOIN
    hrm_designation ee ON c.hrm_designation_id = ee.id
		JOIN
	hrm_employee_shift f ON c.id=f.hrm_employee_job_info_id
        JOIN
	hrm_shift g ON f.hrm_shift_id=g.id
  $P{condition_parameter}
Group By    e.depertment_name,
    a.punch_date,
    a.punch_time,
    g.shift_name,
    ee.alis,
b.employee_name,
c.employee_code
Order bY e.depertment_name,b.employee_name]]>
	</queryString>
