	</parameter>
	<queryString>
		<![CDATA[SELECT
    e.employee_name,
    b.employee_code, 
    c.depertment_name,
    d.alis as designation_name,
d.priority,    
	TIME_FORMAT(a.in_time,"%H:%i") AS in_time,
    TIME_FORMAT(a.out_time,"%H:%i") AS out_time,
    TIME_FORMAT(a.late_time,"%H:%i") AS late_time,
 TIME_FORMAT(IF((a.overtime_time>'00:30:00'),a.overtime_time,TIME_FORMAT("00:00:00", "%H:%i:%s")),"%H:%i:%s") AS overtime_time ,
    aa.comment,
    f.alies as attendance_status,
    g.location_name,
i.shift_name,
j.section_name
FROM
    hrm_attendance a
        JOIN
    hrm_employee_job_info b ON a.hrm_employee_id = b.hrm_employee_id
        JOIN
    hrm_depertment c ON b.hrm_depertment_id = c.id
        JOIN
    hrm_designation d ON b.hrm_designation_id = d.id
        JOIN
    hrm_employee e ON a.hrm_employee_id = e.id
        JOIN
    hrm_attendance_status f ON a.attendance_status = f.id
		JOIN
	hrm_location g ON b.hrm_location_id = g.id
 Join hrm_employee_shift h on b.id=h.hrm_employee_job_info_id
     Join hrm_shift i on h.hrm_shift_id=i.id
join hrm_section j ON j.id=b.hrm_section_id
$P!{condition_parameter}
Left JOIN 
(SELECT 
  DISTINCT  a.hrm_employee_id, a.punch_date,group_concat(c.comment) as comment,b.id as job_id
FROM
    hrm_attendance_raw_data a
        JOIN
    hrm_employee_job_info b ON a.hrm_employee_id = b.hrm_employee_id
        AND a.data_from = 2
$P!{condition_parameter_1} 
        JOIN
    hrm_attendance_comment c ON a.id = c.hrm_attendance_raw_data_id
    GROUP BY a.hrm_employee_id, a.punch_date,b.id) aa ON a.hrm_employee_id=aa.hrm_employee_id AND aa.punch_date=a.punche_date AND aa.job_id=b.id
Order By j.section_name,d.priority,b.employee_code]]>
	</queryString>
